---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getAppUrl } from '../utils/app-url';

const title = 'Security at LocalPDF | Private PDF workflow and trust model';
const description = 'Understand the LocalPDF security story: local-first PDF workflows, trust boundaries, and what users should verify before opening the app.';
const canonical = 'https://localpdf.online/security';
const image = 'https://localpdf.online/og/home.svg';
const appUrl = getAppUrl();

const trustFaqs = [
  {
    question: 'What does LocalPDF mean by local-first PDF workflow?',
    answer: 'The marketing site explains PDF tasks in practical terms and points users into workflows designed to start on the user device.',
  },
  {
    question: 'What should users verify before opening LocalPDF?',
    answer: 'Users should confirm the workflow fits the job, read the trust boundaries, and decide whether the document should stay in a local-first flow.',
  },
  {
    question: 'Which LocalPDF workflows are most trust-sensitive?',
    answer: 'Editing, signing, OCR, conversion, and selective page handling are common trust-sensitive PDF jobs because they often involve internal or sensitive documents.',
  },
];

const trustWorkflows = [
  { href: '/features/edit-pdf', label: 'Edit PDF' },
  { href: '/features/sign-pdf', label: 'Sign PDF' },
  { href: '/features/ocr-pdf', label: 'OCR PDF' },
  { href: '/features/convert-pdf', label: 'Convert PDF' },
  { href: '/features/split-pdf', label: 'Split PDF' },
];

const securitySchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    isPartOf: {
      '@type': 'WebSite',
      name: 'LocalPDF',
      url: 'https://localpdf.online/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: trustFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://localpdf.online/' },
      { '@type': 'ListItem', position: 2, name: 'Security', item: canonical },
    ],
  },
];

const pillars = [
  {
    title: 'Local-first workflow',
    body: 'PDF work is meant to start on the user device, especially when the document is sensitive, internal, or operationally important.',
  },
  {
    title: 'Claim discipline',
    body: 'LocalPDF keeps privacy messaging specific to the workflow so users can understand what the product does without vague or inflated claims.',
  },
  {
    title: 'Honest trust model',
    body: 'Trust improves when the product explains where local handling matters, what happens before the app opens, and where the workflow has clear boundaries.',
  },
];

const rules = [
  ['What LocalPDF is built for', 'Sensitive documents, practical PDF tasks, and workflows that should begin on the user device instead of in an upload queue.'],
  ['What this page avoids', 'Broad absolutes, vague trust theater, and promises that go beyond what the product can explain clearly.'],
  ['What users should expect', 'A local-first workflow, practical explanations, and an easy path into the app once the trust questions are answered.'],
];

const boundaryItems = [
  'The local-first workflow is explained before the user is asked to act.',
  'Trust pages describe product behavior in plain language.',
  'Security copy should help the user understand the product instead of hiding behind abstract branding.',
  'Website and app boundaries are easier to trust when they are explained directly.',
];
---

<MarketingLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  schema={securitySchema}
>
  <div class="page-shell">
    <section class="section intro">
      <div class="intro-grid">
        <div>
          <span class="eyebrow">Security</span>
          <h1>How LocalPDF handles privacy for sensitive PDF work</h1>
          <p class="section-intro">
            This page explains where local processing matters, how LocalPDF frames privacy in practical
            terms, and what users should understand before they open the app.
          </p>
          <div class="cta-row">
            <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
            <a class="btn-secondary" href="/faq">Read FAQ</a>
          </div>
        </div>

        <div class="boundary-panel">
          <small>What this page covers</small>
          <ul class="bullet-list">
            <li>How local-first handling fits into the workflow</li>
            <li>What privacy claims LocalPDF does and does not make</li>
            <li>Where trust questions matter before the click</li>
            <li>What to verify before opening the app</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section pillar-grid">
      {pillars.map((item) => (
        <article class="card pillar-card">
          <h2>{item.title}</h2>
          <p>{item.body}</p>
        </article>
      ))}
    </section>

    <section class="section factual-strip">
      <div>
        <span class="eyebrow">Security in plain language</span>
        <h2 class="section-title">How LocalPDF approaches sensitive document work</h2>
        <p class="section-intro">
          LocalPDF is a privacy-first PDF editor built around local-first browser workflows. Core jobs are designed to
          start on the user device, which makes the product a stronger fit for contracts, invoices, records, and other
          sensitive PDFs.
        </p>
      </div>
      <div class="rules">
        <div class="rule">
          <strong>Local-first start</strong>
          <p>Core workflows are designed to begin locally instead of requiring an upload-first handoff.</p>
        </div>
        <div class="rule">
          <strong>Best for sensitive files</strong>
          <p>LocalPDF is especially useful for PDFs that contain legal, finance, HR, or internal business data.</p>
        </div>
        <div class="rule">
          <strong>Trust before action</strong>
          <p>Users can evaluate the trust model before they open the app and start working on a document.</p>
        </div>
      </div>
    </section>

    <section class="section split-layout">
      <div>
        <span class="eyebrow">Trust boundary</span>
        <h2 class="section-title">A practical trust model</h2>
        <p class="section-intro">
          Security is useful when it helps users understand the workflow clearly. The goal is simple:
          explain where local handling matters and give users enough confidence to choose the right tool.
        </p>
        <ul class="bullet-list boundary-list">
          {boundaryItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="boundary-box">
        <strong>What matters most before the click</strong>
        <p>
          Users need to know what LocalPDF is for, why local handling matters for sensitive files,
          and what they can expect before they start working on a document.
        </p>
        <div class="cta-row">
          <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
          <a class="btn-secondary" href="/faq">See Common Questions</a>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">What you can expect from LocalPDF</h2>
      <div class="rules">
        {rules.map(([label, body]) => (
          <div class="rule">
            <strong>{label}</strong>
            <p>{body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Workflows where trust questions show up first</h2>
      <p class="section-intro">
        These are the LocalPDF pages people often open after validating the trust model and deciding the document should stay in a local-first workflow.
      </p>
      <div class="cta-row">
        {trustWorkflows.map((item) => (
          <a class="btn-secondary" href={item.href}>{item.label}</a>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Use cases that benefit most from local-first handling</h2>
      <div class="cta-row">
        <a class="btn-secondary" href="/use-cases/lawyers">For lawyers</a>
        <a class="btn-secondary" href="/use-cases/accountants">For accountants</a>
        <a class="btn-secondary" href="/compare/localpdf-vs-smallpdf">Compare with Smallpdf</a>
      </div>
    </section>

    <section class="section final-band">
      <div>
        <span class="eyebrow">Decision point</span>
        <h2 class="section-title">A clear trust model makes the next step easier</h2>
        <p class="section-intro">
          A clear workflow and a believable trust story make the decision easier. The next step should
          feel simple once the user understands how LocalPDF fits the job.
        </p>
      </div>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
        <a class="btn-secondary" href="/faq">Read FAQ</a>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .intro h1 {
    font-size: clamp(3rem, 5vw, 5rem);
    margin-top: 18px;
    margin-bottom: 18px;
    max-width: 11ch;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 22px;
    align-items: start;
  }

  .factual-strip {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 20px;
    align-items: start;
  }

  .boundary-panel,
  .boundary-box {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 24px;
  }

  .boundary-panel {
    background: linear-gradient(180deg, rgba(217, 235, 225, 0.72), rgba(255, 253, 249, 0.98));
  }

  .boundary-box {
    background: linear-gradient(180deg, rgba(243, 201, 146, 0.24), rgba(255, 253, 249, 0.98));
  }

  .boundary-panel small {
    display: block;
    margin-bottom: 12px;
    color: #8a572d;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .pillar-card h2 {
    font-size: 1.45rem;
    margin-bottom: 12px;
  }

  .split-layout {
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: 22px;
    align-items: start;
  }

  .boundary-list {
    max-width: 760px;
  }

  .boundary-box strong {
    display: block;
    margin-bottom: 12px;
    font-size: 1.08rem;
    color: var(--text);
  }

  .boundary-box p {
    margin-bottom: 18px;
  }

  .rules {
    display: grid;
    gap: 14px;
  }

  .rule {
    padding: 18px 20px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .rule strong {
    display: block;
    margin-bottom: 8px;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8a572d;
  }

  .final-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  @media (max-width: 900px) {
    .intro-grid,
    .pillar-grid,
    .split-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

  }
</style>
