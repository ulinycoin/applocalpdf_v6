---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getAppUrl } from '../utils/app-url';
import { PAGE_DEMO_VIDEOS } from '../data/page-demo-videos';
import { buildVideoObjects } from '../utils/video-object';

const title = 'Private PDF Editor — Edit PDFs Locally | LocalPDF';
const description = 'Edit, merge, OCR, and sign PDFs privately — all processing stays on your device. No upload, no server. Open and start working locally.';
const canonical = 'https://localpdf.online/private-pdf-editor';
const image = 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const appUrl = getAppUrl();

const redactDemo = PAGE_DEMO_VIDEOS['/private-pdf-editor'][0];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    about: { '@type': 'Thing', name: 'Private PDF editor' },
  },
  ...buildVideoObjects(PAGE_DEMO_VIDEOS['/private-pdf-editor'] ?? [], { pageUrl: canonical }),
];
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image} schema={schema}>
  <div class="page-shell hero-shell">
    <section class="section hero">
      <span class="eyebrow">Category</span>
      <h1>Edit PDF Privately — No Upload, All Processing Stays on Your Device</h1>
      <p class="section-intro">
        LocalPDF is a private PDF editor built for editing, merging, OCR, splitting, signing, and converting PDFs in a
        local-first browser workflow. It makes the most sense when the file is important enough that uploading it first
        feels like the wrong default.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
        <a class="btn-secondary" href="/security">Read Security</a>
      </div>
    </section>

    <section class="section card-grid">
      <article class="card"><h3>Best for</h3><p>Contracts, invoices, internal records, finance files, scanned documents, and practical PDF tasks that benefit from local-first handling.</p></article>
      <article class="card"><h3>Core jobs</h3><p>Edit, merge, OCR, compress, split, sign, and convert PDFs without turning the workflow into a utility-page maze.</p></article>
      <article class="card"><h3>Main value</h3><p>Privacy-first positioning, practical browser workflows, and clearer trust before the first click.</p></article>
    </section>

    <section class="section">
      <h2 class="section-title">Erase sensitive content before the file leaves your desk</h2>
      <p class="section-intro">Whiteout paints over account numbers, names, or clauses and bakes the change into the page. Because the edit happens in your browser, the unredacted version is never sent anywhere.</p>
      <figure class="demo-figure">
        <video
          class="demo-video"
          src={redactDemo.src}
          poster={redactDemo.poster}
          width="1200"
          height="750"
          muted
          loop
          playsinline
          preload="none"
          aria-label={redactDemo.alt}
        ></video>
        <figcaption>{redactDemo.caption}</figcaption>
      </figure>
    </section>

    <section class="section">
      <h2 class="section-title">Related workflows</h2>
      <div class="cta-row">
        <a class="btn-secondary" href="/features/edit-pdf">Edit PDF locally</a>
        <a class="btn-secondary" href="/features/merge-pdf">Merge PDF locally</a>
        <a class="btn-secondary" href="/features/ocr-pdf">OCR PDF locally</a>
        <a class="btn-secondary" href="/features/convert-pdf">Convert PDF locally</a>
        <a class="btn-secondary" href="/features/protect-pdf">Password-protect a PDF locally</a>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>.hero-shell h1{font-size:clamp(3rem,5vw,4.8rem);margin-top:18px;margin-bottom:18px;max-width:11ch;}</style>
