---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getAppUrl } from '../utils/app-url';

const title = 'Process PDFs Locally in Browser — No Upload, No Server | LocalPDF';
const description = 'Process PDFs entirely in your browser — edit, merge, OCR, compress, split, sign, and convert. Zero uploads, no server storage, works offline. See how local PDF processing actually works.';
const canonical = 'https://localpdf.online/how-local-pdf-processing-works';
const image = 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const appUrl = getAppUrl(undefined, { upload: '1' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: canonical,
    author: { '@type': 'Organization', name: 'LocalPDF' },
    publisher: { '@type': 'Organization', name: 'LocalPDF' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to process PDFs locally in your browser',
    description,
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Open a PDF from your device', text: 'Open LocalPDF and load a PDF directly from your computer, phone, or tablet. The file stays on your device — nothing is uploaded.' },
      { '@type': 'HowToStep', position: 2, name: 'Edit, merge, OCR, compress, sign, or convert', text: 'Choose the tool you need. All processing runs locally in your browser via WebAssembly — no server round-trips, no file transmission.' },
      { '@type': 'HowToStep', position: 3, name: 'Download the result', text: 'Export the processed file. It was never stored, never transmitted, and never seen by any server.' },
    ],
  },
];
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image} schema={schema}>
  <div class="page-shell hero-shell">
    <section class="section hero">
      <span class="eyebrow">How It Works</span>
      <h1>Process PDFs Locally in Your Browser — No Upload, No Server</h1>
      <p class="section-intro">
        Every PDF tool on LocalPDF runs entirely in your browser using WebAssembly. Your files
        stay on your device — open, edit, merge, OCR, compress, sign, convert, and download
        without a single byte ever leaving your computer. Works offline after the first load.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Open LocalPDF — it's free
        </a>
        <a class="btn-secondary" href="/security">Read Security Details</a>
      </div>
      <div class="hero-trust">
        <span class="tag">0 bytes uploaded</span>
        <span class="tag">Works offline</span>
        <span class="tag">No account needed</span>
      </div>
    </section>

    <section class="section card-grid">
      <article class="card">
        <h3>How local PDF processing works</h3>
        <p>When you open a PDF in LocalPDF, the file is loaded into your browser's memory. Every tool — edit, merge, OCR, compress, split, sign, convert — runs as WebAssembly code on your device. There is no server involved. Your file is never uploaded, never stored, and never transmitted anywhere. After the initial page load, all processing continues to work without an internet connection.</p>
      </article>
      <article class="card">
        <h3>Why processing locally matters</h3>
        <p>For contracts, invoices, scanned IDs, legal documents, and internal records, uploading a file to a third-party server creates risk. Local processing eliminates that risk entirely — the file never leaves your control. No privacy policy to trust, no data retention to worry about, no breach exposure.</p>
      </article>
      <article class="card">
        <h3>What you can do locally</h3>
        <p>Edit PDF text and images. Merge multiple documents with drag-and-drop. Run OCR on scanned files. Compress before emailing. Split pages out of large documents. Sign and convert between formats. All of it locally, all in one workspace.</p>
      </article>
    </section>

    <section class="section">
      <h2>Common questions about local PDF processing</h2>
      <div class="faq-grid">
        <div class="faq-card">
          <h3>Does the file really never leave my device?</h3>
          <p>Correct. LocalPDF loads the file into browser memory. All tools are compiled to WebAssembly and execute locally. There is no server-side processing, no upload queue, and no file storage. You can verify this by disconnecting your internet after the page loads — everything keeps working.</p>
        </div>
        <div class="faq-card">
          <h3>Is local processing as fast as server-side?</h3>
          <p>For most PDF tasks, local processing is faster — there is no upload delay, no queue, no download wait. Editing and merging are near-instant. OCR and heavy compression take 1-2 seconds per page, comparable to server-side but without the privacy trade-off.</p>
        </div>
        <div class="faq-card">
          <h3>Which PDF tasks work offline?</h3>
          <p>All of them. Edit, merge, OCR, compress, split, sign, and convert all work without an internet connection after the initial page load. PDF processing runs entirely on your device.</p>
        </div>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .hero-shell h1 {
    font-size: clamp(2.6rem, 4.5vw, 4.4rem);
    margin-top: 18px;
    margin-bottom: 18px;
    max-width: 16ch;
  }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .tag {
    padding: 4px 14px;
    border-radius: 999px;
    background: rgba(217, 235, 225, 0.6);
    border: 1px solid var(--line);
    font-size: 0.82rem;
    color: #30414e;
    font-weight: 600;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 20px;
  }
  .faq-card {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
  }
  .faq-card h3 {
    font-size: 1.1rem;
    margin-bottom: 10px;
  }
  .faq-card p {
    font-size: 0.95rem;
  }
</style>
