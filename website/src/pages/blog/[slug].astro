---
import MarketingLayout from '../../layouts/MarketingLayout.astro';

const toolRouteMap: Record<string, { href: string; label: string }> = {
  'merge-pdf': { href: '/features/merge-pdf', label: 'Merge PDF' },
  'split-pdf': { href: '/features/split-pdf', label: 'Split PDF' },
  'compress-pdf': { href: '/features/compress-pdf', label: 'Compress PDF' },
  'ocr-pdf': { href: '/features/ocr-pdf', label: 'OCR PDF' },
  'sign-pdf': { href: '/features/sign-pdf', label: 'Sign PDF' },
  'pdf-to-word': { href: '/features/convert-pdf', label: 'Convert PDF' },
  'word-to-pdf': { href: '/features/convert-pdf', label: 'Convert PDF' },
};

type BlogModule = {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    draft?: boolean;
    tags: string[];
    category: string;
    author: string;
    canonicalURL?: string;
    ogImage?: string;
    relatedTools?: string[];
  };
  default: unknown;
};

export function getStaticPaths() {
  const postModules = import.meta.glob('../../content/blog/*.mdx', { eager: true }) as Record<string, BlogModule>;
  const allPosts = Object.entries(postModules)
    .map(([path, module]) => ({
      slug: path.split('/').pop()?.replace(/\.mdx$/, '') ?? '',
      data: {
        ...module.frontmatter,
        pubDate: new Date(module.frontmatter.pubDate),
      },
      Content: module.default,
    }))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const Content = post.Content;
const postModules = import.meta.glob('../../content/blog/*.mdx', { eager: true }) as Record<string, BlogModule>;
const allPosts = Object.entries(postModules)
  .map(([path, module]) => ({
    slug: path.split('/').pop()?.replace(/\.mdx$/, '') ?? '',
    data: {
      ...module.frontmatter,
      pubDate: new Date(module.frontmatter.pubDate),
    },
    Content: module.default,
  }))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const relatedPosts = allPosts
  .filter((candidate) => candidate.slug !== post.slug)
  .filter((candidate) => candidate.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3);

const relatedFeatureLinks = (post.data.relatedTools ?? [])
  .map((tool) => toolRouteMap[tool])
  .filter((item, index, array): item is { href: string; label: string } => Boolean(item) && array.findIndex((entry) => entry?.href === item?.href) === index)
  .slice(0, 3);

const canonical = post.data.canonicalURL || `https://localpdf.online/blog/${post.slug}`;
const title = `${post.data.title} | LocalPDF Blog`;
const description = post.data.description;
const image = post.data.ogImage || 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const readingTimeSource = JSON.stringify(post.data.title) + JSON.stringify(post.data.description) + post.data.tags.join(' ');
const readingTime = Math.max(3, Math.ceil(readingTimeSource.split(/\s+/).length / 220));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description,
    datePublished: post.data.pubDate.toISOString(),
    author: {
      '@type': 'Organization',
      name: post.data.author,
    },
    publisher: {
      '@type': 'Organization',
      name: 'LocalPDF',
      logo: 'https://localpdf.online/logos/localpdf-header-96x96.png',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonical,
    },
    image,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://localpdf.online/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://localpdf.online/blog' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
    ],
  },
];
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image} schema={schema}>
  <div class="page-shell">
    <article class="section article-shell">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog">Blog</a>
        <span>/</span>
        <span>{post.data.title}</span>
      </div>

      <div class="article-meta">
        <span class="eyebrow">{post.data.category}</span>
        <div class="meta-row">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          <span>{readingTime} min read</span>
        </div>
      </div>

      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>

      {relatedFeatureLinks.length > 0 && (
        <div class="cta-strip">
          <strong>Related workflows in LocalPDF</strong>
          <div class="cta-row">
            {relatedFeatureLinks.map((item) => (
              <a class="btn-secondary" href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>
      )}

      <div class="content">
        <Content />
      </div>
    </article>

    {relatedPosts.length > 0 && (
      <section class="section">
        <h2 class="section-title">Related articles</h2>
        <div class="card-grid related-grid">
          {relatedPosts.map((item) => (
            <a class="related-card" href={`/blog/${item.slug}`}>
              <span class="related-label">{item.data.category}</span>
              <h3>{item.data.title}</h3>
              <p>{item.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</MarketingLayout>

<style>
  .article-shell h1 {
    font-size: clamp(2.8rem, 4.8vw, 4.8rem);
    margin-top: 18px;
    margin-bottom: 18px;
    max-width: 14ch;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.92rem;
    color: #536674;
    margin-bottom: 20px;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: #536674;
    font-size: 0.95rem;
  }

  .lead {
    max-width: 760px;
    margin-bottom: 24px;
    font-size: 1.08rem;
  }

  .cta-strip {
    margin-bottom: 28px;
    padding: 20px;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(243, 201, 146, 0.2), rgba(255, 253, 249, 0.98));
    border: 1px solid var(--line);
  }

  .cta-strip strong {
    display: block;
    margin-bottom: 12px;
    font-size: 1.05rem;
  }

  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    margin-top: 32px;
    margin-bottom: 14px;
    line-height: 1.1;
  }

  .content :global(h2) {
    font-size: 2rem;
  }

  .content :global(h3) {
    font-size: 1.45rem;
  }

  .content :global(p),
  .content :global(li) {
    color: var(--text-soft);
    line-height: 1.72;
    font-size: 1.02rem;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 22px;
  }

  .content :global(a) {
    color: #8a572d;
  }

  .content :global(code) {
    padding: 0.12rem 0.35rem;
    border-radius: 6px;
    background: rgba(20, 32, 40, 0.06);
    font-size: 0.92em;
  }

  .related-card {
    display: block;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
    text-decoration: none;
  }

  .related-label {
    display: inline-block;
    margin-bottom: 12px;
    color: #8a572d;
    font-weight: 800;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .related-card h3 {
    font-size: 1.25rem;
    margin-bottom: 10px;
  }
</style>
