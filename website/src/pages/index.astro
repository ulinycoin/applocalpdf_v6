---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { featurePages } from '../data/featurePages';
import { getAppUrl } from '../utils/app-url';

const title = 'Private PDF editing that stays on your device | LocalPDF';
const description = 'LocalPDF is a privacy-first PDF app for editing, merging, OCR, compression, signing, splitting, and conversion without an upload-first workflow.';
const canonical = 'https://localpdf.online/';
const image = 'https://localpdf.online/og/home.svg';
const appUrl = getAppUrl();

const websiteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'LocalPDF',
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalPDF',
    url: canonical,
    logo: 'https://localpdf.online/logos/localpdf-header-96x96.png',
  },
];

const primaryFeatures = featurePages.filter((page) => [
  'edit-pdf',
  'merge-pdf',
  'ocr-pdf',
  'compress-pdf',
  'split-pdf',
  'convert-pdf',
].includes(page.slug));
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image} schema={websiteSchema}>
  <div class="page-shell">
    <section class="hero section">
      <div class="hero-copy">
        <span class="eyebrow">Privacy-first PDF app</span>
        <h1>Private PDF editing that stays on your device</h1>
        <p class="hero-text">
          LocalPDF gives you one place to edit, merge, OCR, compress, split, sign, and
          convert PDFs without turning every document into an upload-first workflow.
        </p>
        <div class="cta-row">
          <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
          <a class="btn-secondary" href="/security">See How Local Processing Works</a>
        </div>
        <div class="hero-notes">
          <span>No upload workflow for sensitive documents</span>
          <span>Workspace flow instead of disconnected one-off tools</span>
          <span>Built for practical PDF jobs, not decorative claims</span>
        </div>
      </div>

      <div class="hero-panel">
        <div class="panel-top">
          <span>Workspace</span>
          <strong>LocalPDF</strong>
        </div>
        <div class="panel-body">
          <div class="metric-row">
            <div>
              <small>Primary jobs</small>
              <strong>Edit, Merge, OCR, Convert</strong>
            </div>
            <div>
              <small>Why it exists</small>
              <strong>Keep PDF work close to the file</strong>
            </div>
          </div>
          <div class="workspace-preview" aria-hidden="true">
            <div class="preview-rail">
              <span>Edit</span>
              <span>Merge</span>
              <span>OCR</span>
              <span>Convert</span>
            </div>
            <div class="preview-canvas">
              <div class="canvas-sheet">
                <div class="canvas-status-row">
                  <span>Local file added</span>
                  <span>Ready to export</span>
                </div>
                <div class="canvas-line wide"></div>
                <div class="canvas-line"></div>
                <div class="canvas-line short"></div>
                <div class="canvas-card-row">
                  <div class="canvas-card mint"></div>
                  <div class="canvas-card sand"></div>
                </div>
                <div class="canvas-line wide"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section trust-strip">
      <div class="trust-item">
        <strong>No upload workflow</strong>
        <p>Designed for jobs where documents should stay close to the user.</p>
      </div>
      <div class="trust-item">
        <strong>One product path</strong>
        <p>Open the app and continue the job instead of bouncing across utility pages.</p>
      </div>
      <div class="trust-item">
        <strong>Trust surfaced early</strong>
        <p>Security and FAQ are part of the acquisition path because this product depends on trust.</p>
      </div>
    </section>

    <section class="section decision-strip">
      <div class="decision-copy">
        <h2 class="section-title">What LocalPDF should make obvious in the first screen</h2>
        <p class="section-intro">
          Users should not have to decode the product. The homepage needs to resolve what LocalPDF is,
          why local processing matters, and when this workflow is a better fit than an upload-first tool.
        </p>
      </div>
      <div class="decision-box">
        <strong>Use LocalPDF when</strong>
        <ul class="bullet-list">
          <li>You want one product path instead of many disconnected utility pages</li>
          <li>The document is internal, sensitive, or operationally important</li>
          <li>The task is editing, merging, OCR, splitting, signing, compression, or conversion</li>
        </ul>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Core workflows inside the app</h2>
      <p class="section-intro">
        Most product demand concentrates around a short list of real PDF jobs. These are the workflows
        that deserve dedicated pages, stronger messaging, and a direct path into the app.
      </p>
      <div class="card-grid feature-grid">
        {primaryFeatures.map((feature) => (
          <a class="feature-card" href={`/features/${feature.slug}`}>
            <span class="feature-label">{feature.eyebrow}</span>
            <h3>{feature.title}</h3>
            <p>{feature.metaDescription}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section split-layout">
      <div>
        <h2 class="section-title">Why local processing changes the decision</h2>
        <p class="section-intro">
          The point is not to sound mystical about privacy. The point is to give users a practical
          reason to choose a different workflow when the document is sensitive or simply too important
          to treat as a disposable upload.
        </p>
      </div>
      <div class="callout-list">
        <div class="callout">
          <strong>Less exposure by default</strong>
          <p>Keeping the first step local is easier to justify for contracts, scans, invoices, and internal files.</p>
        </div>
        <div class="callout">
          <strong>Less friction before action</strong>
          <p>Open the app, load the document, finish the job, export the result. No queue-shaped marketing loop.</p>
        </div>
        <div class="callout">
          <strong>Less route sprawl</strong>
          <p>One strong feature page per core workflow is easier to trust than a directory of thin pages saying nearly the same thing.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">What LocalPDF is built for</h2>
      <div class="card-grid">
        <div class="card">
          <h3>Sensitive internal documents</h3>
          <p>Contracts, invoices, records, and drafts that users do not want to treat as disposable uploads.</p>
        </div>
        <div class="card">
          <h3>Fast operational PDF work</h3>
          <p>Merging, splitting, compressing, and preparing files without waiting for remote processing loops.</p>
        </div>
        <div class="card">
          <h3>One product surface</h3>
          <p>A PDF app that feels like a workspace, not a list of unrelated online tools.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">What LocalPDF is and what it is not</h2>
      <div class="card-grid comparison-grid">
        <div class="card">
          <h3>What it is</h3>
          <ul class="bullet-list">
            <li>A PDF app built around core document workflows</li>
            <li>A privacy-first product for users who want processing closer to the file</li>
            <li>A compact landing architecture with clear routes into the app</li>
          </ul>
        </div>
        <div class="card">
          <h3>What it is not</h3>
          <ul class="bullet-list">
            <li>Not a maze of one-purpose pages pretending to be different products</li>
            <li>Not a decorative “privacy” brand without a usable app behind it</li>
            <li>Not a workflow that starts by assuming every file should be uploaded first</li>
          </ul>
        </div>
        <div class="card">
          <h3>What a strong landing must prove</h3>
          <ul class="bullet-list">
            <li>The app is real and central to the experience</li>
            <li>The trust story is specific, not theatrical</li>
            <li>The next step is clear before the user reaches the fold</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section faq-preview">
      <div>
        <span class="eyebrow">Trust and clarity</span>
        <h2 class="section-title">Questions users ask before opening the app</h2>
      </div>
      <div class="faq-list">
        <div class="faq-item">
          <strong>Do I have to upload my PDF first?</strong>
          <p>No. The product direction is centered on local-first handling for practical PDF jobs.</p>
        </div>
        <div class="faq-item">
          <strong>What jobs does LocalPDF actually cover?</strong>
          <p>Edit, merge, OCR, compress, split, sign, and conversion workflows are the current core.</p>
        </div>
        <div class="faq-item">
          <strong>Where should I verify the trust model?</strong>
          <p>Security and FAQ are first-class pages because trust is part of the product decision, not footer clutter.</p>
        </div>
      </div>
    </section>

    <section class="section final-band">
      <div>
        <span class="eyebrow">Next step</span>
        <h2 class="section-title">Open the app, then judge the workflow directly</h2>
        <p class="section-intro">
          The landing only needs to do one job well: explain why LocalPDF is worth opening for practical PDF work
          that should stay closer to the user and the file.
        </p>
      </div>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
        <a class="btn-secondary" href="/faq">Read FAQ</a>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 24px;
    align-items: stretch;
    margin-top: 28px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }

  .hero h1 {
    font-size: clamp(3.4rem, 7vw, 6.4rem);
    max-width: 9ch;
  }

  .hero-text {
    max-width: 700px;
    font-size: 1.08rem;
  }

  .hero-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .hero-notes span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(217, 235, 225, 0.85);
    color: #24353f;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .hero-panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 30px;
    background: linear-gradient(180deg, rgba(255, 253, 249, 0.96), rgba(247, 244, 239, 0.8));
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    color: #536674;
  }

  .panel-body {
    padding: 20px;
    display: grid;
    gap: 18px;
  }

  .metric-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .metric-row div {
    padding: 14px;
    border-radius: 18px;
    background: rgba(217, 235, 225, 0.5);
  }

  .metric-row small {
    display: block;
    margin-bottom: 8px;
    color: #536674;
  }

  .metric-row strong {
    color: var(--text);
  }

  .panel-body img {
    display: none;
  }

  .workspace-preview {
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: 14px;
    min-height: 290px;
  }

  .preview-rail {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 14px;
    border-radius: 18px;
    background: rgba(255, 253, 249, 0.8);
    border: 1px solid var(--line);
  }

  .preview-rail span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 12px;
    background: rgba(217, 235, 225, 0.6);
    color: #27404c;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .preview-canvas {
    padding: 14px;
    border-radius: 18px;
    background: rgba(255, 253, 249, 0.8);
    border: 1px solid var(--line);
  }

  .canvas-sheet {
    height: 100%;
    min-height: 248px;
    padding: 18px;
    border-radius: 16px;
    background: linear-gradient(180deg, #fffdf9 0%, #fcf9f3 100%);
    border: 1px solid rgba(20, 32, 40, 0.08);
  }

  .canvas-status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .canvas-status-row span {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(217, 235, 225, 0.9);
    color: #244153;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .canvas-line {
    height: 10px;
    margin-bottom: 12px;
    border-radius: 999px;
    background: rgba(20, 32, 40, 0.12);
  }

  .canvas-line.wide {
    width: 88%;
  }

  .canvas-line.short {
    width: 48%;
  }

  .canvas-card-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 18px 0;
  }

  .canvas-card {
    min-height: 92px;
    border-radius: 14px;
    border: 1px solid rgba(20, 32, 40, 0.08);
  }

  .canvas-card.mint {
    background: rgba(217, 235, 225, 0.8);
  }

  .canvas-card.sand {
    background: rgba(243, 201, 146, 0.55);
  }

  .trust-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .trust-item {
    padding: 10px 8px;
  }

  .trust-item strong {
    display: block;
    margin-bottom: 8px;
    font-size: 1rem;
  }

  .feature-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .decision-strip {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 20px;
    align-items: start;
  }

  .decision-box {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(243, 201, 146, 0.24), rgba(255, 253, 249, 0.95));
  }

  .decision-box strong {
    display: block;
    margin-bottom: 12px;
    font-size: 1.05rem;
  }

  .feature-card {
    display: block;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(26, 34, 39, 0.04);
  }

  .feature-card:hover,
  .feature-card:focus-visible {
    border-color: rgba(20, 32, 40, 0.18);
    transform: translateY(-2px);
  }

  .feature-label {
    display: inline-block;
    margin-bottom: 12px;
    color: #8a572d;
    font-weight: 800;
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .feature-card h3 {
    font-size: 1.5rem;
    margin-bottom: 12px;
  }

  .comparison-grid .card {
    min-height: 100%;
  }

  .split-layout {
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: 20px;
    align-items: start;
  }

  .callout-list {
    display: grid;
    gap: 14px;
  }

  .callout {
    padding: 18px 20px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .callout strong {
    display: block;
    margin-bottom: 8px;
    font-size: 1.05rem;
  }

  .final-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .faq-preview {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 20px;
    align-items: start;
  }

  .faq-list {
    display: grid;
    gap: 14px;
  }

  .faq-item {
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--surface);
  }

  .faq-item strong {
    display: block;
    margin-bottom: 10px;
    font-size: 1.05rem;
    color: var(--text);
  }

  @media (max-width: 960px) {
    .hero,
    .split-layout,
    .trust-strip,
    .decision-strip,
    .feature-grid,
    .faq-preview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      margin-top: 16px;
    }

    .metric-row {
      grid-template-columns: 1fr;
    }

    .workspace-preview {
      grid-template-columns: 1fr;
    }

    .preview-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
