---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { featurePages } from '../data/featurePages';
import { getAppUrl } from '../utils/app-url';
import { CATEGORIES, ICONS } from '../data/tools';

function getToolHref(toolId: string): string {
  const mapping: Record<string, string> = {
    'edit-text-pdf': '/features/edit-pdf',
    'add-text-pdf': '/features/edit-pdf',
    'sign-pdf': '/features/sign-pdf',
    'add-form-fields-pdf': '/features/edit-pdf',
    'watermark-pdf': '/features/edit-pdf',
    'flatten-pdf': '/features/edit-pdf',
    
    'merge-pdf': '/features/merge-pdf',
    'split-pdf': '/features/split-pdf',
    'compress-pdf': '/features/compress-pdf',
    'auto-toc-pdf': '/features/auto-toc-pdf',
    'organize-pdf': '/features/split-pdf',
    'rotate-pdf': '/features/split-pdf',
    'delete-pages-pdf': '/features/split-pdf',
    'extract-pages-pdf': '/features/split-pdf',
    
    'tables-pdf': '/features/convert-pdf',
    'ocr-pdf': '/features/ocr-pdf',
    'pdf-to-word': '/features/convert-pdf',
    'word-to-pdf': '/features/convert-pdf',
    'images-to-pdf': '/features/convert-pdf',
    'pdf-to-images': '/features/convert-pdf',
    'extract-images-pdf': '/features/convert-pdf',
    
    'protect-pdf': '/features/edit-pdf'
  };
  return mapping[toolId] || '/';
}

const title = 'Edit PDFs Locally — Private PDF Editor & OCR in Browser | LocalPDF';
const description = 'Edit, merge, OCR, compress, split, and convert PDFs locally in your browser. Zero uploads, no server, works offline. Free PDF editor — open and start.';
const canonical = 'https://localpdf.online/';
const image = 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const imageAlt = 'LocalPDF — private PDF editor that runs entirely in your browser';
const appUrl = getAppUrl(undefined, { upload: '1' });

const homepageFaqs = [
  {
    question: 'Do I need to upload my PDF to use LocalPDF?',
    answer: 'No. LocalPDF runs entirely in your browser. You open a file from your device, work on it, and download the result — nothing is uploaded to any server.',
  },
  {
    question: 'Can I really drag pages between different PDFs?',
    answer: 'Yes. Open two PDFs side by side in the canvas, select a page from one, and drag it into the other. The page is copied instantly — no extract-then-merge workflow required.',
  },
  {
    question: 'Is LocalPDF really free? What\'s the catch?',
    answer: 'All six core tools — edit PDF, merge PDF, OCR PDF, compress PDF, split PDF, and convert PDF — are completely free. There\'s a Pro plan that unlocks higher workspace limits for heavy users, but there\'s no trial expiration, no hidden limits on basic usage, and no credit card required to start.',
  },
  {
    question: 'How is this different from Smallpdf or Adobe Acrobat?',
    answer: 'Two key differences. First, LocalPDF keeps everything on your device — no uploads, no server storage, no privacy policies to trust. Second, LocalPDF uses a visual canvas where you can work with multiple documents side by side and drag pages between them, not a list of separate tool pages each requiring its own upload.',
  },
  {
    question: 'Does LocalPDF work without internet?',
    answer: 'Yes. After the initial page load, all processing runs locally in your browser via WebAssembly. You can edit, merge, OCR, compress, split, and convert PDFs on a plane, train, or anywhere with no internet connection.',
  },
  {
    question: 'What browsers does LocalPDF support?',
    answer: 'LocalPDF works in Chrome, Firefox, Safari, and Edge. All processing uses WebAssembly, so there\'s nothing to install. You can also install it as a Chrome app via the PWA prompt for quick access.',
  },
];

const websiteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'LocalPDF',
    url: canonical,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalPDF',
    url: canonical,
    logo: 'https://localpdf.online/logos/localpdf-header-96x96.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalPDF',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: canonical,
    description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      'Edit PDF locally without uploading',
      'Merge PDF files in one workspace',
      'Run OCR on scanned PDFs locally',
      'Drag-and-drop pages between documents',
      'Works offline without internet',
      'Compress, split, sign, and convert PDFs',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homepageFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const popularGuides = [
  {
    href: '/blog/how-to-merge-pdf-files',
    title: 'How to Merge PDF Files',
    description: 'Combine multiple PDFs into one document without uploading them anywhere.',
  },
  {
    href: '/blog/compress-pdf-without-losing-quality',
    title: 'How to Compress PDF Without Losing Quality',
    description: 'Reduce PDF file size while keeping quality — all locally, no upload.',
  },
  {
    href: '/blog/ocr-pdf-extract-text',
    title: 'OCR PDF: Extract Text from Scans',
    description: 'Turn scanned PDFs into searchable documents — all locally, no upload required.',
  },
];

const hreflangs = [
  { hreflang: 'en', href: 'https://localpdf.online/' },
  { hreflang: 'ja', href: 'https://localpdf.online/ja' },
  { hreflang: 'zh', href: 'https://localpdf.online/zh' },
  { hreflang: 'x-default', href: 'https://localpdf.online/' }
];
---

<MarketingLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  schema={websiteSchema}
  hreflangs={hreflangs}
>
  <div class="page-shell">

    <!-- HERO -->
    <section class="hero section">
      <div class="hero-copy">
        <span class="eyebrow">Private PDF editor — 100% local</span>
        <h1>Edit PDFs Locally — Private PDF Editor, Merger &amp; OCR in Your Browser</h1>
        <p class="hero-text">
          A full PDF workspace that runs entirely on your device. Edit text, merge documents,
          run OCR on scans, compress, split, and convert — with zero uploads, no server storage,
          and full offline support. Drag pages between documents visually, like paper on a desk.
        </p>
        <div class="hero-price">Free to use — no account required</div>
        <div class="cta-row">
          <a href={appUrl} class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Open LocalPDF — it's free
          </a>
          <a href="#how-it-works" class="btn-secondary">How it works</a>
        </div>
        <div class="hero-trust">
          <span class="tag">0 bytes uploaded</span>
          <span class="tag">Works offline</span>
          <span class="tag">No account needed</span>
          <span class="tag">Used by legal, finance &amp; HR</span>
        </div>
      </div>

      <div class="dropzone-card" id="dropzone" data-app-url={appUrl}>
        <div class="dropzone-inner-wrapper">
          <div class="dropzone-grid-bg"></div>
          <div class="dropzone-grid-highlight"></div>
          <div class="dropzone-content">
            <div class="dropzone-icon-container">
              <div class="simple-doc-wrapper">
                <div class="simple-doc">
                  <div class="simple-doc-fold"></div>
                  <div class="simple-doc-lines">
                    <div class="simple-doc-line" style="width: 80%;"></div>
                    <div class="simple-doc-line" style="width: 60%;"></div>
                    <div class="simple-doc-line" style="width: 70%;"></div>
                  </div>
                  <div class="simple-doc-tag">PDF</div>
                </div>
                <div class="simple-doc-shadow"></div>
              </div>
            </div>
            <div class="dropzone-text-group">
              <strong class="dropzone-title">Drag & drop your PDF here</strong>
              <span class="dropzone-subtitle">or click to choose file</span>
              <span class="dropzone-hint">Free to try for standard documents &bull; No credit card required</span>
            </div>
            <span class="dropzone-privacy-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              100% Local &amp; Private
            </span>
          </div>
        </div>
        <input type="file" id="dropzone-file-input" accept=".pdf" style="display: none;" />
      </div>

      <script>
        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('dropzone-file-input') as HTMLInputElement | null;

        if (dropzone && fileInput) {
          dropzone.addEventListener('click', () => {
            fileInput.click();
          });

          fileInput.addEventListener('change', () => {
            const files = fileInput.files;
            if (files && files.length > 0) {
              void handleFileTransfer(files[0]);
            }
          });

          dropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropzone.classList.add('dragover');
          });

          dropzone.addEventListener('dragleave', () => {
            dropzone.classList.remove('dragover');
          });

          dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropzone.classList.remove('dragover');
            const files = e.dataTransfer?.files;
            if (files && files.length > 0) {
              const file = files[0];
              if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
                void handleFileTransfer(file);
              } else {
                alert('Please upload a PDF file.');
              }
            }
          });

          let mouseX = 0;
          let mouseY = 0;
          let targetX = 0;
          let targetY = 0;
          let isHovered = false;
          let frameId = 0;

          function tick() {
            if (!isHovered) return;
            mouseX += (targetX - mouseX) * 0.08;
            mouseY += (targetY - mouseY) * 0.08;
            dropzone.style.setProperty('--mouse-x', `${mouseX}px`);
            dropzone.style.setProperty('--mouse-y', `${mouseY}px`);
            frameId = requestAnimationFrame(tick);
          }

          dropzone.addEventListener('mouseenter', (e) => {
            isHovered = true;
            const rect = dropzone.getBoundingClientRect();
            targetX = e.clientX - rect.left;
            targetY = e.clientY - rect.top;
            mouseX = targetX;
            mouseY = targetY;
            cancelAnimationFrame(frameId);
            tick();
          });

          dropzone.addEventListener('mousemove', (e) => {
            const rect = dropzone.getBoundingClientRect();
            targetX = e.clientX - rect.left;
            targetY = e.clientY - rect.top;
          });

          dropzone.addEventListener('mouseleave', () => {
            isHovered = false;
            cancelAnimationFrame(frameId);
          });

          // Create a premium full-screen drag overlay
          const overlay = document.createElement('div');
          overlay.id = 'window-drag-overlay';
          Object.assign(overlay.style, {
            position: 'fixed',
            inset: '0',
            zIndex: '99999',
            backgroundColor: 'rgba(21, 34, 27, 0.88)',
            backdropFilter: 'blur(12px)',
            webkitBackdropFilter: 'blur(12px)',
            display: 'none',
            alignItems: 'center',
            justifyContent: 'center',
            color: '#ffffff',
            transition: 'opacity 0.25s cubic-bezier(0.25, 0.8, 0.25, 1)',
            opacity: '0',
            pointerEvents: 'none'
          });

          overlay.innerHTML = `
            <div style="
              border: 1.5px dashed rgba(80, 184, 108, 0.5);
              border-radius: 28px;
              padding: 48px 32px;
              text-align: center;
              max-width: 440px;
              width: 90%;
              display: flex;
              flex-direction: column;
              align-items: center;
              gap: 20px;
              background: rgba(15, 27, 35, 0.7);
              box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            ">
              <div style="
                width: 72px;
                height: 72px;
                background: rgba(80, 184, 108, 0.12);
                border: 1px solid rgba(80, 184, 108, 0.3);
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
                animation: floatDoc 2.4s ease-in-out infinite;
              ">📄</div>
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <strong style="
                  font-size: 1.45rem;
                  font-family: 'Iowan Old Style', Georgia, serif;
                  font-weight: 700;
                  color: #eaf8ee;
                ">Drop your PDF anywhere</strong>
                <span style="
                  font-size: 0.92rem;
                  color: #a5d6a7;
                  font-weight: 500;
                  opacity: 0.9;
                ">to load it directly into the secure local workspace</span>
              </div>
            </div>
          `;
          document.body.appendChild(overlay);

          let dragCounter = 0;

          window.addEventListener('dragenter', (e) => {
            const types = e.dataTransfer?.types;
            const hasFiles = types && Array.from(types).includes('Files');
            if (!hasFiles) return;

            e.preventDefault();
            dragCounter++;
            if (dragCounter === 1) {
              overlay.style.display = 'flex';
              // Force reflow
              overlay.offsetHeight;
              overlay.style.opacity = '1';
            }
          });

          window.addEventListener('dragover', (e) => {
            e.preventDefault();
          });

          window.addEventListener('dragleave', (e) => {
            dragCounter--;
            if (dragCounter === 0) {
              overlay.style.opacity = '0';
              setTimeout(() => {
                if (dragCounter === 0) overlay.style.display = 'none';
              }, 250);
            }
          });

          window.addEventListener('drop', (e) => {
            e.preventDefault();
            dragCounter = 0;
            overlay.style.opacity = '0';
            overlay.style.display = 'none';

            const files = e.dataTransfer?.files;
            if (files && files.length > 0) {
              const file = files[0];
              if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
                void handleFileTransfer(file);
              } else {
                alert('Please upload a PDF file.');
              }
            }
          });
        }

        async function handleFileTransfer(file: File) {
          if (dropzone) {
            dropzone.classList.add('uploading');
            const titleEl = dropzone.querySelector('.dropzone-title');
            const subtitleEl = dropzone.querySelector('.dropzone-subtitle');
            if (titleEl) titleEl.textContent = 'Loading file...';
            if (subtitleEl) subtitleEl.textContent = file.name;
          }

          try {
            await saveFileToTransferDB(file);
            const appUrl = dropzone?.getAttribute('data-app-url') || '/app/studio';
            window.location.href = appUrl;
          } catch (err) {
            console.error('File transfer failed, trying sessionStorage fallback', err);
            try {
              const reader = new FileReader();
              reader.onload = (e) => {
                const dataUrl = e.target?.result;
                if (dataUrl) {
                  sessionStorage.setItem('localpdf_transfer_file', JSON.stringify({
                    name: file.name,
                    type: file.type,
                    dataUrl: dataUrl
                  }));
                  const appUrl = dropzone?.getAttribute('data-app-url') || '/app/studio';
                  window.location.href = appUrl;
                }
              };
              reader.readAsDataURL(file);
            } catch (fallbackErr) {
              console.error('Fallback failed', fallbackErr);
              alert('Could not load file. Please try again.');
              if (dropzone) {
                dropzone.classList.remove('uploading');
                const titleEl = dropzone.querySelector('.dropzone-title');
                const subtitleEl = dropzone.querySelector('.dropzone-subtitle');
                if (titleEl) titleEl.textContent = 'Drag & drop your PDF here';
                if (subtitleEl) subtitleEl.textContent = 'or click to choose file';
              }
            }
          }
        }

        function saveFileToTransferDB(file: File): Promise<void> {
          return new Promise((resolve, reject) => {
            const request = indexedDB.open('localpdf-transfer', 1);
            request.onupgradeneeded = () => {
              const db = request.result;
              if (!db.objectStoreNames.contains('transfer-files')) {
                db.createObjectStore('transfer-files', { keyPath: 'id' });
              }
            };
            request.onsuccess = () => {
              const db = request.result;
              const tx = db.transaction('transfer-files', 'readwrite');
              const store = tx.objectStore('transfer-files');
              const putRequest = store.put({
                id: 'pending',
                blob: file,
                name: file.name,
                type: file.type,
                timestamp: Date.now()
              });
              tx.oncomplete = () => {
                db.close();
                resolve();
              };
              tx.onerror = () => {
                db.close();
                reject(tx.error);
              };
            };
            request.onerror = () => {
              reject(request.error);
            };
          });
        }
      </script>
    </section>

    <!-- ALL UTILITIES toolkit -->
    <section class="section all-tools-section">
      <span class="eyebrow">All Utilities</span>
      <h2 class="section-title">A complete private PDF toolkit on your device</h2>
      <p class="section-intro">No uploads, no limits, no subscription paywalls for basic usage. Click any tool to open it directly in the canvas.</p>
      
      <div class="toolkit-categories">
        {CATEGORIES.map((category) => (
          <div class="toolkit-category">
            <div class="category-header">
              <span class="category-icon" set:html={ICONS[category.icon]} />
              <h3>{category.name}</h3>
            </div>
            <div class="category-tools-list">
              {category.tools.map((tool) => (
                <a href={getToolHref(tool.id)} class="tool-item-link">
                  <div class="tool-item-icon" set:html={ICONS[tool.icon]} />
                  <h4>{tool.name}</h4>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PAIN / RELIEF -->
    <section class="section">
      <span class="eyebrow">Before and after</span>
      <h2 class="section-title">The old way vs the LocalPDF way</h2>
      <p class="section-intro">
        If you've ever needed to move a page between PDFs or just wanted to edit a document
        without uploading it somewhere — here's how the experience changes.
      </p>
      <div class="split-2">
        <div class="pain-card">
          <h3>With online PDF tools</h3>
          <ul>
            <li>Upload the file to a remote server</li>
            <li>Use a separate page for each operation</li>
            <li>Extract pages with one tool, merge with another</li>
            <li>Wait for every upload and download</li>
            <li>Accept whatever their privacy policy says</li>
            <li>Create an account to do more than one thing</li>
          </ul>
        </div>
        <div class="relief-card">
          <h3>With LocalPDF</h3>
          <ul>
            <li>Open a file from your device — zero upload</li>
            <li>All tools in one canvas, switch freely</li>
            <li>Drag pages between documents directly</li>
            <li>Instant response, no network roundtrips</li>
            <li>Nothing leaves your device, ever</li>
            <li>No account, no signup, no subscription</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="section">
      <span class="eyebrow">How it works</span>
      <h2 class="section-title">Open, work, export — in three steps</h2>
      <p class="section-intro">No accounts, no uploads, no servers. Just a workspace that works the way you expect.</p>
      <div class="steps-grid">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Open a PDF</h3>
          <p>Drag any PDF into the Studio or open it from your device. The file stays in your browser's memory — zero bytes sent anywhere. Works offline too.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>Work visually</h3>
          <p><a href="/features/edit-pdf">Edit text</a>, <a href="/features/merge-pdf">merge documents</a>, <a href="/features/ocr-pdf">run OCR</a>, reorder pages by dragging, or move pages between open PDFs — all on the canvas.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>Export the result</h3>
          <p>Download the finished PDF. No cleanup, no accounts to delete, no files left on someone else's server.</p>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section">
      <span class="eyebrow">Core tools</span>
      <h2 class="section-title">The most in-demand PDF tools</h2>
      <p class="section-intro">Six most-used tools, all in one workspace. Switch between them without leaving the document.</p>
      <div class="feat-grid">
        <a href="/features/edit-pdf" class="feat-card">
          <div class="feat-icon">✎</div>
          <div><h3>Edit PDF</h3><p>Edit text and images directly on the page</p></div>
        </a>
        <a href="/features/merge-pdf" class="feat-card">
          <div class="feat-icon">⊞</div>
          <div><h3>Merge PDF</h3><p>Combine documents by dragging pages together</p></div>
        </a>
        <a href="/features/ocr-pdf" class="feat-card">
          <div class="feat-icon">◎</div>
          <div><h3>OCR PDF</h3><p>Extract text from scanned documents, local processing</p></div>
        </a>
        <a href="/features/compress-pdf" class="feat-card">
          <div class="feat-icon">▼</div>
          <div><h3>Compress PDF</h3><p>Reduce file size without uploading to a server</p></div>
        </a>
        <a href="/features/split-pdf" class="feat-card">
          <div class="feat-icon">⎔</div>
          <div><h3>Split PDF</h3><p>Extract or remove pages from any document</p></div>
        </a>
        <a href="/features/convert-pdf" class="feat-card">
          <div class="feat-icon">⇄</div>
          <div><h3>Convert PDF</h3><p>PDF to JPG and other format conversions</p></div>
        </a>
      </div>
    </section>

    <!-- BLOG GUIDES -->
    <section class="section">
      <span class="eyebrow">Quick guides</span>
      <h2 class="section-title">How to edit, merge, and OCR PDFs — privately</h2>
      <p class="section-intro">Real workflows that make the most of local-first PDF processing.</p>
      <div class="blog-strip">
        {popularGuides.map((guide) => (
          <a href={guide.href} class="blog-card">
            <div class="blog-label">Guide</div>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- COMPARISON -->
    <section class="section">
      <span class="eyebrow">Why LocalPDF</span>
      <h2 class="section-title">Local-first vs upload-first PDF tools</h2>
      <p class="section-intro">The difference is simple: your files never leave your device. Here's what that means in practice.</p>
      <div class="comp-grid">
        <div class="comp-card comp-accent">
          <h3>LocalPDF</h3>
          <ul>
            <li>Files stay in your browser</li>
            <li>Drag-and-drop between documents</li>
            <li>One workspace for everything</li>
            <li>Works offline</li>
            <li>No account required</li>
            <li>Zero bytes sent to servers</li>
          </ul>
        </div>
        <div class="comp-card comp-cross">
          <h3>Smallpdf / iLovePDF / Adobe</h3>
          <ul>
            <li>Files uploaded to remote servers</li>
            <li>One tool per page, no workspace</li>
            <li>Separate page for each operation</li>
            <li>Requires internet connection</li>
            <li>Account upsells everywhere</li>
            <li>Privacy depends on a policy page</li>
          </ul>
        </div>
        <div class="comp-card">
          <h3>Best for</h3>
          <ul>
            <li>Contracts and legal documents</li>
            <li>Invoices and financial records</li>
            <li>HR files and offer letters</li>
            <li>Sensitive operational PDFs</li>
            <li>Offline work on the go</li>
            <li>Anyone who values privacy</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <span class="eyebrow">FAQ</span>
      <h2 class="section-title">Common questions about private PDF editing</h2>
      <div class="faq-grid">
        {homepageFaqs.map((faq) => (
          <div class="faq-item">
            <strong>{faq.question}</strong>
            <p>{faq.answer}</p>
          </div>
