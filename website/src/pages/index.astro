---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { featurePages } from '../data/featurePages';
import { getAppUrl } from '../utils/app-url';

const title = 'Private PDF Editor — Edit, Merge & OCR in Browser | LocalPDF';
const description = 'Edit, merge, OCR, compress, split, and convert PDFs privately in your browser. Zero uploads, no server storage, works offline. Open LocalPDF — it\'s free.';
const canonical = 'https://localpdf.online/';
const image = 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const imageAlt = 'LocalPDF — private PDF editor that runs entirely in your browser';
const appUrl = getAppUrl(undefined, { upload: '1' });

const homepageFaqs = [
  {
    question: 'Do I need to upload my PDF to use LocalPDF?',
    answer: 'No. LocalPDF runs entirely in your browser. You open a file from your device, work on it, and download the result — nothing is uploaded to any server.',
  },
  {
    question: 'Can I really drag pages between different PDFs?',
    answer: 'Yes. Open two PDFs side by side in the canvas, select a page from one, and drag it into the other. The page is copied instantly — no extract-then-merge workflow required.',
  },
  {
    question: 'Is LocalPDF really free? What\'s the catch?',
    answer: 'All six core tools — edit PDF, merge PDF, OCR PDF, compress PDF, split PDF, and convert PDF — are completely free. There\'s a Pro plan that unlocks higher workspace limits for heavy users, but there\'s no trial expiration, no hidden limits on basic usage, and no credit card required to start.',
  },
  {
    question: 'How is this different from Smallpdf or Adobe Acrobat?',
    answer: 'Two key differences. First, LocalPDF keeps everything on your device — no uploads, no server storage, no privacy policies to trust. Second, LocalPDF uses a visual canvas where you can work with multiple documents side by side and drag pages between them, not a list of separate tool pages each requiring its own upload.',
  },
  {
    question: 'Does LocalPDF work without internet?',
    answer: 'Yes. After the initial page load, all processing runs locally in your browser via WebAssembly. You can edit, merge, OCR, compress, split, and convert PDFs on a plane, train, or anywhere with no internet connection.',
  },
  {
    question: 'What browsers does LocalPDF support?',
    answer: 'LocalPDF works in Chrome, Firefox, Safari, and Edge. All processing uses WebAssembly, so there\'s nothing to install. You can also install it as a Chrome app via the PWA prompt for quick access.',
  },
];

const websiteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'LocalPDF',
    url: canonical,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalPDF',
    url: canonical,
    logo: 'https://localpdf.online/logos/localpdf-header-96x96.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalPDF',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: canonical,
    description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      'Edit PDF locally without uploading',
      'Merge PDF files in one workspace',
      'Run OCR on scanned PDFs locally',
      'Drag-and-drop pages between documents',
      'Works offline without internet',
      'Compress, split, sign, and convert PDFs',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homepageFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const popularGuides = [
  {
    href: '/blog/how-to-merge-pdf-files',
    title: 'How to Merge PDF Files',
    description: 'Combine multiple PDFs into one document without uploading them anywhere.',
  },
  {
    href: '/blog/edit-text-in-pdf-guide',
    title: 'How to Edit Text in a PDF',
    description: 'Edit PDF text directly — replace words, cover sensitive sections, and more.',
  },
  {
    href: '/blog/ocr-pdf-extract-text',
    title: 'OCR PDF: Extract Text from Scans',
    description: 'Turn scanned PDFs into searchable documents — all locally, no upload required.',
  },
];
---

<MarketingLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  schema={websiteSchema}
>
  <div class="page-shell">

    <!-- HERO -->
    <section class="hero section">
      <div class="hero-copy">
        <span class="eyebrow">Private PDF editor — 100% local</span>
        <h1>Private PDF Editor — Edit, Merge, and OCR PDFs in Your Browser</h1>
        <p class="hero-text">
          A full PDF workspace that runs entirely on your device. Edit text, merge documents,
          run OCR on scans, compress, split, and convert — with zero uploads, no server storage,
          and full offline support. Drag pages between documents visually, like paper on a desk.
        </p>
        <div class="hero-price">Free to use — no account required</div>
        <div class="cta-row">
          <a href={appUrl} class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            Open LocalPDF — it's free
          </a>
          <a href="#how-it-works" class="btn-secondary">How it works</a>
        </div>
        <div class="hero-trust">
          <span class="tag">0 bytes uploaded</span>
          <span class="tag">Works offline</span>
          <span class="tag">No account needed</span>
          <span class="tag">Used by legal, finance &amp; HR</span>
        </div>
      </div>

      <div class="hero-panel">
        <div class="panel-bar">
          <div class="bar-dots">
            <div class="bar-dot r"></div>
            <div class="bar-dot y"></div>
            <div class="bar-dot g"></div>
          </div>
          <span class="bar-label">Studio — contract_draft.pdf</span>
        </div>
        <div class="canvas-area">
          <div class="doc-card doc1">
            <div class="doc-head">
              <div class="doc-dot"></div>
              contract_draft.pdf
              <span class="doc-pages">6 pages</span>
            </div>
            <div class="doc-pages-row">
              <div class="page-thumb"><div class="line" style="width:85%"></div><div class="line"></div><div class="line img-line"></div><div class="line" style="width:70%"></div><div class="page-num">1</div></div>
              <div class="page-thumb page-selected"><div class="line" style="width:70%"></div><div class="line img-line" style="height:30px"></div><div class="line" style="width:50%"></div><div class="page-num">3</div></div>
              <div class="page-thumb"><div class="line" style="width:60%"></div><div class="line"></div><div class="line" style="width:80%"></div><div class="page-num">5</div></div>
            </div>
          </div>
          <div class="drag-arrow">↕</div>
          <div class="doc-card doc2">
            <div class="doc-head">
              <div class="doc-dot doc-dot-accent"></div>
              invoice_march.pdf
              <span class="doc-pages">2 pages</span>
            </div>
            <div class="doc-pages-row">
              <div class="page-thumb"><div class="line" style="width:60%"></div><div class="line" style="width:80%"></div><div class="line img-line" style="background:#dce8dc;"></div><div class="page-num">1</div></div>
              <div class="page-thumb page-drop"><div class="drop-plus">+</div><div class="page-num drop-label">drop</div></div>
            </div>
          </div>
        </div>
        <div class="canvas-caption">
          Drag pages between documents visually — no other PDF tool works this way.
        </div>
      </div>
    </section>

    <!-- STATS -->
    <div class="section stats-section" role="region" aria-label="Key numbers">
      <div class="stat">
        <strong>0 bytes</strong>
        <p>uploaded to any server — everything runs in your browser</p>
      </div>
      <div class="stat">
        <strong>6 tools</strong>
        <p>edit, merge, OCR, compress, split, convert — all in one workspace</p>
      </div>
      <div class="stat">
        <strong>Offline</strong>
        <p>works without internet — on a plane, train, anywhere</p>
      </div>
      <div class="stat">
        <strong>&lt; 50ms</strong>
        <p>action latency — no waiting for servers, instant response</p>
      </div>
    </div>

    <!-- PAIN / RELIEF -->
    <section class="section">
      <span class="eyebrow">Before and after</span>
      <h2 class="section-title">The old way vs the LocalPDF way</h2>
      <p class="section-intro">
        If you've ever needed to move a page between PDFs or just wanted to edit a document
        without uploading it somewhere — here's how the experience changes.
      </p>
      <div class="split-2">
        <div class="pain-card">
          <h3>With online PDF tools</h3>
          <ul>
            <li>Upload the file to a remote server</li>
            <li>Use a separate page for each operation</li>
            <li>Extract pages with one tool, merge with another</li>
            <li>Wait for every upload and download</li>
            <li>Accept whatever their privacy policy says</li>
            <li>Create an account to do more than one thing</li>
          </ul>
        </div>
        <div class="relief-card">
          <h3>With LocalPDF</h3>
          <ul>
            <li>Open a file from your device — zero upload</li>
            <li>All tools in one canvas, switch freely</li>
            <li>Drag pages between documents directly</li>
            <li>Instant response, no network roundtrips</li>
            <li>Nothing leaves your device, ever</li>
            <li>No account, no signup, no subscription</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="section">
      <span class="eyebrow">How it works</span>
      <h2 class="section-title">Open, work, export — in three steps</h2>
      <p class="section-intro">No accounts, no uploads, no servers. Just a workspace that works the way you expect.</p>
      <div class="steps-grid">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Open a PDF</h3>
          <p>Drag any PDF into the Studio or open it from your device. The file stays in your browser's memory — zero bytes sent anywhere. Works offline too.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>Work visually</h3>
          <p><a href="/features/edit-pdf">Edit text</a>, <a href="/features/merge-pdf">merge documents</a>, <a href="/features/ocr-pdf">run OCR</a>, reorder pages by dragging, or move pages between open PDFs — all on the canvas.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>Export the result</h3>
          <p>Download the finished PDF. No cleanup, no accounts to delete, no files left on someone else's server.</p>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section">
      <span class="eyebrow">Core tools</span>
      <h2 class="section-title">The most in-demand PDF tools</h2>
      <p class="section-intro">Six most-used tools, all in one workspace. Switch between them without leaving the document.</p>
      <div class="feat-grid">
        <a href="/features/edit-pdf" class="feat-card">
          <div class="feat-icon">✎</div>
          <div><h3>Edit PDF</h3><p>Edit text and images directly on the page</p></div>
        </a>
        <a href="/features/merge-pdf" class="feat-card">
          <div class="feat-icon">⊞</div>
          <div><h3>Merge PDF</h3><p>Combine documents by dragging pages together</p></div>
        </a>
        <a href="/features/ocr-pdf" class="feat-card">
          <div class="feat-icon">◎</div>
          <div><h3>OCR PDF</h3><p>Extract text from scanned documents, local processing</p></div>
        </a>
        <a href="/features/compress-pdf" class="feat-card">
          <div class="feat-icon">▼</div>
          <div><h3>Compress PDF</h3><p>Reduce file size without uploading to a server</p></div>
        </a>
        <a href="/features/split-pdf" class="feat-card">
          <div class="feat-icon">⎔</div>
          <div><h3>Split PDF</h3><p>Extract or remove pages from any document</p></div>
        </a>
        <a href="/features/convert-pdf" class="feat-card">
          <div class="feat-icon">⇄</div>
          <div><h3>Convert PDF</h3><p>PDF to JPG and other format conversions</p></div>
        </a>
      </div>
    </section>

    <!-- BLOG GUIDES -->
    <section class="section">
      <span class="eyebrow">Quick guides</span>
      <h2 class="section-title">How to edit, merge, and OCR PDFs — privately</h2>
      <p class="section-intro">Real workflows that make the most of local-first PDF processing.</p>
      <div class="blog-strip">
        {popularGuides.map((guide) => (
          <a href={guide.href} class="blog-card">
            <div class="blog-label">Guide</div>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- COMPARISON -->
    <section class="section">
      <span class="eyebrow">Why LocalPDF</span>
      <h2 class="section-title">Local-first vs upload-first PDF tools</h2>
      <p class="section-intro">The difference is simple: your files never leave your device. Here's what that means in practice.</p>
      <div class="comp-grid">
        <div class="comp-card comp-accent">
          <h3>LocalPDF</h3>
          <ul>
            <li>Files stay in your browser</li>
            <li>Drag-and-drop between documents</li>
            <li>One workspace for everything</li>
            <li>Works offline</li>
            <li>No account required</li>
            <li>Zero bytes sent to servers</li>
          </ul>
        </div>
        <div class="comp-card comp-cross">
          <h3>Smallpdf / iLovePDF / Adobe</h3>
          <ul>
            <li>Files uploaded to remote servers</li>
            <li>One tool per page, no workspace</li>
            <li>Separate page for each operation</li>
            <li>Requires internet connection</li>
            <li>Account upsells everywhere</li>
            <li>Privacy depends on a policy page</li>
          </ul>
        </div>
        <div class="comp-card">
          <h3>Best for</h3>
          <ul>
            <li>Contracts and legal documents</li>
            <li>Invoices and financial records</li>
            <li>HR files and offer letters</li>
            <li>Sensitive operational PDFs</li>
            <li>Offline work on the go</li>
            <li>Anyone who values privacy</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <span class="eyebrow">FAQ</span>
      <h2 class="section-title">Common questions about private PDF editing</h2>
      <div class="faq-grid">
        {homepageFaqs.map((faq) => (
          <div class="faq-item">
            <strong>{faq.question}</strong>
            <p>{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="section final-cta">
      <h2>Try the PDF workspace that keeps your files private</h2>
      <p class="section-intro">No signup, no upload, no commitment. Just a PDF tool that works the way it should.</p>
      <div class="cta-row cta-center">
        <a href={appUrl} class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Open LocalPDF — it's free
        </a>
        <a href="/faq" class="btn-secondary">Read FAQ</a>
      </div>
    </section>

  </div>
</MarketingLayout>

<style>
  /* ── Hero ─────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 28px;
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-copy h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    line-height: 1.05;
    max-width: 18ch;
  }

  .hero-text {
    font-size: 1.05rem;
    max-width: 520px;
    margin: 0;
  }

  .hero-price {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 6px;
    background: rgba(222, 122, 45, 0.1);
    border: 1px solid rgba(222, 122, 45, 0.25);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    width: fit-content;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--text-soft);
    font-weight: 500;
  }

  /* ── Hero panel / canvas ───────────────────── */
  .hero-panel {
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .panel-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    background: rgba(247, 244, 239, 0.9);
    border-bottom: 1px solid var(--line);
  }

  .bar-dots {
    display: flex;
    gap: 5px;
  }

  .bar-dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
  }

  .bar-dot.r { background: #e0524a; }
  .bar-dot.y { background: #e6b422; }
  .bar-dot.g { background: #50b86c; }

  .bar-label {
    font-size: 0.78rem;
    color: var(--text-soft);
    margin-left: 4px;
  }

  .canvas-area {
    padding: 20px;
    background:
      radial-gradient(circle at 20px 20px, rgba(20,32,40,0.08) 1px, transparent 1px);
    background-size: 24px 24px;
    background-color: #f0ede8;
    min-height: 300px;
    position: relative;
  }

  .doc-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    overflow: hidden;
    width: 46%;
    position: absolute;
  }

  .doc1 { top: 36px; left: 20px; }
  .doc2 { bottom: 32px; right: 20px; opacity: 0.88; }

  .doc-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-soft);
    background: var(--surface);
  }

  .doc-dot {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: #50b86c;
    flex-shrink: 0;
  }

  .doc-dot-accent { background: var(--accent); }

  .doc-pages {
    margin-left: auto;
    font-size: 0.7rem;
    color: #8d98a3;
    font-weight: 400;
  }

  .doc-pages-row {
    display: flex;
    gap: 8px;
    padding: 10px 12px;
  }

  .page-thumb {
    width: 52px;
    height: 70px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    padding: 6px 5px;
    gap: 4px;
    flex-shrink: 0;
    position: relative;
  }

  .page-selected {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(222, 122, 45, 0.15);
  }

  .page-drop {
    border-style: dashed;
    border-color: var(--accent);
    opacity: 0.65;
    align-items: center;
    justify-content: center;
  }

  .drop-plus {
    font-size: 1.4rem;
    color: var(--accent);
    margin: auto;
  }

  .drop-label {
    position: absolute;
    bottom: 3px;
    right: 4px;
    font-size: 8px;
    color: var(--accent);
    font-weight: 600;
  }

  .line {
    height: 3px;
    background: #ddd9d2;
    border-radius: 2px;
    width: 100%;
  }

  .img-line {
    height: 20px;
    background: #e8e5de;
    border-radius: 2px;
  }

  .page-num {
    position: absolute;
    bottom: 3px;
    right: 4px;
    font-size: 8px;
    color: #8d98a3;
    font-weight: 500;
  }

  .drag-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.4rem;
    color: var(--accent);
    font-weight: 700;
    opacity: 0.75;
  }

  .canvas-caption {
    padding: 10px 16px 12px;
    font-size: 0.82rem;
    color: var(--text-soft);
    border-top: 1px solid var(--line);
  }

  /* ── Stats ─────────────────────────────────── */
  .stats-section {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    text-align: center;
  }

  .stat strong {
    display: block;
    font-size: 1.9rem;
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
    color: var(--text);
  }

  .stat p {
    font-size: 0.85rem;
  }

  /* ── Pain / Relief ─────────────────────────── */
  .split-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 20px;
  }

  .pain-card,
  .relief-card {
    padding: 22px;
    border-radius: 12px;
  }

  .pain-card {
    background: rgba(220, 38, 38, 0.04);
    border: 1px solid rgba(220, 38, 38, 0.14);
  }

  .relief-card {
    background: rgba(222, 122, 45, 0.06);
    border: 1px solid rgba(222, 122, 45, 0.2);
  }

  .pain-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #b0443e;
    margin-bottom: 14px;
  }

  .relief-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .pain-card ul,
  .relief-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pain-card li,
  .relief-card li {
    font-size: 0.9rem;
    color: var(--text-soft);
    padding-left: 14px;
    position: relative;
  }

  .pain-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 4px;
    height: 4px;
    background: #b0443e;
    border-radius: 1px;
  }

  .relief-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 1px;
  }

  /* ── How it works ──────────────────────────── */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .step {
    padding: 22px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(247, 244, 239, 0.7);
  }

  .step-num {
    display: inline-flex;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--text);
