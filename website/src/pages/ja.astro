---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { featurePages } from '../data/featurePages';
import { getAppUrl } from '../utils/app-url';
import { CATEGORIES, ICONS } from '../data/tools';

function getToolHref(toolId: string): string {
  const mapping: Record<string, string> = {
    'edit-text-pdf': '/features/edit-pdf',
    'add-text-pdf': '/features/edit-pdf',
    'sign-pdf': '/features/sign-pdf',
    'add-form-fields-pdf': '/features/edit-pdf',
    'watermark-pdf': '/features/edit-pdf',
    'flatten-pdf': '/features/edit-pdf',
    
    'merge-pdf': '/features/merge-pdf',
    'split-pdf': '/features/split-pdf',
    'compress-pdf': '/features/compress-pdf',
    'auto-toc-pdf': '/features/auto-toc-pdf',
    'organize-pdf': '/features/split-pdf',
    'rotate-pdf': '/features/split-pdf',
    'delete-pages-pdf': '/features/split-pdf',
    'extract-pages-pdf': '/features/split-pdf',
    
    'tables-pdf': '/features/convert-pdf',
    'ocr-pdf': '/features/ocr-pdf',
    'pdf-to-word': '/features/convert-pdf',
    'word-to-pdf': '/features/convert-pdf',
    'images-to-pdf': '/features/convert-pdf',
    'pdf-to-images': '/features/convert-pdf',
    'extract-images-pdf': '/features/convert-pdf',
    
    'protect-pdf': '/features/edit-pdf'
  };
  return mapping[toolId] || '/';
}

const title = 'ブラウザで動く個人向けPDFエディタ — 編集、結合、OCR | LocalPDF';
const description = 'ブラウザ上で完全にローカルで動作する個人向けPDFエディタ。ファイルのアップロードは不要で、セキュリティも安全。結合、分割、圧縮、OCR、PDF変換などの各種機能を完全無料で利用できます。';
const canonical = 'https://localpdf.online/ja';
const image = 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const imageAlt = 'LocalPDF — private PDF editor that runs entirely in your browser';
const appUrl = getAppUrl(undefined, { upload: '1' });

const homepageFaqs = [
  {
    question: 'LocalPDFを使用するためにPDFをアップロードする必要がありますか？',
    answer: 'いいえ。LocalPDFは完全にブラウザ内で動作します。お使いのデバイスからファイルを開いて作業し、結果をダウンロードするだけです。ファイルがサーバーにアップロードされることはありません。',
  },
  {
    question: '異なるPDF間でページをドラッグできますか？',
    answer: 'はい。キャンバス上に2つのPDFを並べて開き、一方のページを選択してもう一方へドラッグするだけです。ページは瞬時にコピーされ、個別に抽出して結合し直すような手間は不要です。',
  },
  {
    question: 'LocalPDFは本当に無料ですか？何か裏がありますか？',
    answer: 'はい、PDFの編集、結合、OCR、圧縮、分割、変換の6つのコアツールはすべて完全に無料です。ヘビーユーザー向けにワークスペース制限を緩和するProプラン（月額$3.99）がありますが、無料枠に試用期限や隠れた制限はなく、クレジットカード登録不要で今すぐ使えます。',
  },
  {
    question: 'SmallpdfやAdobe Acrobatと何が違いますか？',
    answer: '大きな違いは2つあります。1つ目は、LocalPDFはすべてをローカル（お使いのデバイス上）で処理するため、ファイルをアップロードする必要がなく、サーバー保存もされないため安心です。2つ目は、機能ごとの個別ページで何回もアップロードし直すのではなく、視覚的なキャンバス上で複数のドキュメントを並べて直感的にページをドラッグ＆ドロップして作業できる点です。',
  },
  {
    question: 'LocalPDFはインターネットがなくても動きますか？',
    answer: 'はい。最初のページ読み込み後は、すべての処理がWebAssemblyを介してブラウザ内でローカルに実行されます。飛行機や電車、電波の届かない場所でも、PDFの編集、結合、OCR、圧縮、分割、変換が可能です。',
  },
  {
    question: 'どのブラウザに対応していますか？',
    answer: 'Chrome、Firefox、Safari、Edgeで動作します。WebAssemblyを利用しているため、プラグイン等のインストールは一切不要です。また、PWA（デスクトップアプリ）としてインストールして素早く起動することもできます。',
  },
];

const websiteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'LocalPDF',
    url: canonical,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalPDF',
    url: canonical,
    logo: 'https://localpdf.online/logos/localpdf-header-96x96.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalPDF',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: canonical,
    description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      'アップロードなしでPDFをローカル編集',
      '1つのワークスペースでPDFファイルを結合',
      'スキャンされたPDFに対してローカルでOCRを実行',
      'ドキュメント間でページをドラッグ＆ドロップ',
      'インターネットなしでオフライン動作',
      'PDFの圧縮、分割、署名、変換',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homepageFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const popularGuides = [
  {
    href: '/features/merge-pdf',
    title: 'PDFをローカルで結合',
    description: 'ファイルをアップロードせずに、複数のPDFを1つのドキュメントに結合します。',
  },
  {
    href: '/features/compress-pdf',
    title: '品質を落とさずPDFを圧縮する方法',
    description: 'アップロードなしで、ファイルサイズを削減しながら品質を維持します。',
  },
  {
    href: '/features/ocr-pdf',
    title: 'PDF OCRをローカルで実行',
    description: 'スキャンされたPDFを検索可能なドキュメントに変換。すべてローカル処理でアップロード不要。',
  },
];

const hreflangs = [
  { hreflang: 'en', href: 'https://localpdf.online/' },
  { hreflang: 'ja', href: 'https://localpdf.online/ja' },
  { hreflang: 'zh', href: 'https://localpdf.online/zh' },
  { hreflang: 'x-default', href: 'https://localpdf.online/' }
];
---

<MarketingLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  schema={websiteSchema}
  hreflangs={hreflangs}
  lang="ja"
>
  <div class="page-shell">

    <!-- HERO -->
    <section class="hero section">
      <div class="hero-copy">
        <span class="eyebrow">個人向けPDFエディタ — 100% ローカル処理</span>
        <h1>ブラウザで動く個人向けPDFエディタ — 編集、結合、OCR</h1>
        <p class="hero-text">
          ファイルのアップロードは一切不要。結合、分割、圧縮、OCR、PDF変換などのすべての作業がお使いのデバイス上のブラウザ内で安全に完結します。まるで机の上の紙を扱うように、ページをドラッグ＆ドロップで移動できます。
        </p>
        <div class="hero-price">無料で利用可能 — アカウント登録不要</div>
        <div class="cta-row">
          <a href={appUrl} class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            LocalPDFを開く（無料）
          </a>
          <a href="#how-it-works" class="btn-secondary">使い方</a>
        </div>
        <div class="hero-trust">
          <span class="tag">アップロード0バイト</span>
          <span class="tag">オフライン動作</span>
          <span class="tag">アカウント不要</span>
          <span class="tag">法務・財務・人事チームも推奨</span>
        </div>
      </div>

      <div class="dropzone-card" id="dropzone" data-app-url={appUrl}>
        <div class="dropzone-inner-wrapper">
          <div class="dropzone-grid-bg"></div>
          <div class="dropzone-grid-highlight"></div>
          <div class="dropzone-content">
            <div class="dropzone-icon-container">
              <div class="simple-doc-wrapper">
                <div class="simple-doc">
                  <div class="simple-doc-fold"></div>
                  <div class="simple-doc-lines">
                    <div class="simple-doc-line" style="width: 80%;"></div>
                    <div class="simple-doc-line" style="width: 60%;"></div>
                    <div class="simple-doc-line" style="width: 70%;"></div>
                  </div>
                  <div class="simple-doc-tag">PDF</div>
                </div>
                <div class="simple-doc-shadow"></div>
              </div>
            </div>
            <div class="dropzone-text-group">
              <strong class="dropzone-title">ここにPDFファイルをドラッグ＆ドロップ</strong>
              <span class="dropzone-subtitle">またはファイルを選択</span>
              <span class="dropzone-hint">標準的なドキュメントは無料でお試しいただけます &bull; クレジットカード登録不要</span>
            </div>
            <span class="dropzone-privacy-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              100% ローカル &amp; 安全
            </span>
          </div>
        </div>
        <input type="file" id="dropzone-file-input" accept=".pdf" style="display: none;" />
      </div>

      <script>
        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('dropzone-file-input') as HTMLInputElement | null;

        if (dropzone && fileInput) {
          dropzone.addEventListener('click', () => {
            fileInput.click();
          });

          fileInput.addEventListener('change', () => {
            const files = fileInput.files;
            if (files && files.length > 0) {
              void handleFileTransfer(files[0]);
            }
          });

          dropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropzone.classList.add('dragover');
          });

          dropzone.addEventListener('dragleave', () => {
            dropzone.classList.remove('dragover');
          });

          dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropzone.classList.remove('dragover');
            const files = e.dataTransfer?.files;
            if (files && files.length > 0) {
              const file = files[0];
              if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
                void handleFileTransfer(file);
              } else {
                alert('PDFファイルを選択してください。');
              }
            }
          });

          let mouseX = 0;
          let mouseY = 0;
          let targetX = 0;
          let targetY = 0;
          let isHovered = false;
          let frameId = 0;

          function tick() {
            if (!isHovered) return;
            mouseX += (targetX - mouseX) * 0.08;
            mouseY += (targetY - mouseY) * 0.08;
            dropzone.style.setProperty('--mouse-x', `${mouseX}px`);
            dropzone.style.setProperty('--mouse-y', `${mouseY}px`);
            frameId = requestAnimationFrame(tick);
          }

          dropzone.addEventListener('mouseenter', (e) => {
            isHovered = true;
            const rect = dropzone.getBoundingClientRect();
            targetX = e.clientX - rect.left;
            targetY = e.clientY - rect.top;
            mouseX = targetX;
            mouseY = targetY;
            cancelAnimationFrame(frameId);
            tick();
          });

          dropzone.addEventListener('mousemove', (e) => {
            const rect = dropzone.getBoundingClientRect();
            targetX = e.clientX - rect.left;
            targetY = e.clientY - rect.top;
          });

          dropzone.addEventListener('mouseleave', () => {
            isHovered = false;
            cancelAnimationFrame(frameId);
          });

          // Create a premium full-screen drag overlay
          const overlay = document.createElement('div');
          overlay.id = 'window-drag-overlay';
          Object.assign(overlay.style, {
            position: 'fixed',
            inset: '0',
            zIndex: '99999',
            backgroundColor: 'rgba(21, 34, 27, 0.88)',
            backdropFilter: 'blur(12px)',
            webkitBackdropFilter: 'blur(12px)',
            display: 'none',
            alignItems: 'center',
            justifyContent: 'center',
            color: '#ffffff',
            transition: 'opacity 0.25s cubic-bezier(0.25, 0.8, 0.25, 1)',
            opacity: '0',
            pointerEvents: 'none'
          });

          overlay.innerHTML = `
            <div style="
              border: 1.5px dashed rgba(80, 184, 108, 0.5);
              border-radius: 28px;
              padding: 48px 32px;
              text-align: center;
              max-width: 440px;
              width: 90%;
              display: flex;
              flex-direction: column;
              align-items: center;
              gap: 20px;
              background: rgba(15, 27, 35, 0.7);
              box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            ">
              <div style="
                width: 72px;
                height: 72px;
                background: rgba(80, 184, 108, 0.12);
                border: 1px solid rgba(80, 184, 108, 0.3);
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
                animation: floatDoc 2.4s ease-in-out infinite;
              ">📄</div>
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <strong style="
                  font-size: 1.45rem;
                  font-family: 'Iowan Old Style', Georgia, serif;
                  font-weight: 700;
                  color: #eaf8ee;
                ">PDFファイルをどこにでもドラッグ＆ドロップしてください</strong>
                <span style="
                  font-size: 0.92rem;
                  color: #a5d6a7;
                  font-weight: 500;
                  opacity: 0.9;
                ">安全なローカルワークスペースに直接読み込まれます</span>
              </div>
            </div>
          `;
          document.body.appendChild(overlay);

          let dragCounter = 0;

          window.addEventListener('dragenter', (e) => {
            const types = e.dataTransfer?.types;
            const hasFiles = types && Array.from(types).includes('Files');
            if (!hasFiles) return;

            e.preventDefault();
            dragCounter++;
            if (dragCounter === 1) {
              overlay.style.display = 'flex';
              // Force reflow
              overlay.offsetHeight;
              overlay.style.opacity = '1';
            }
          });

          window.addEventListener('dragover', (e) => {
            e.preventDefault();
          });

          window.addEventListener('dragleave', (e) => {
            dragCounter--;
            if (dragCounter === 0) {
              overlay.style.opacity = '0';
              setTimeout(() => {
                if (dragCounter === 0) overlay.style.display = 'none';
              }, 250);
            }
          });

          window.addEventListener('drop', (e) => {
            e.preventDefault();
            dragCounter = 0;
            overlay.style.opacity = '0';
            overlay.style.display = 'none';

            const files = e.dataTransfer?.files;
            if (files && files.length > 0) {
              const file = files[0];
              if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
                void handleFileTransfer(file);
              } else {
                alert('PDFファイルを選択してください。');
              }
            }
          });
        }

        async function handleFileTransfer(file: File) {
          if (dropzone) {
            dropzone.classList.add('uploading');
            const titleEl = dropzone.querySelector('.dropzone-title');
            const subtitleEl = dropzone.querySelector('.dropzone-subtitle');
            if (titleEl) titleEl.textContent = 'ファイルを読み込み中...';
            if (subtitleEl) subtitleEl.textContent = file.name;
          }

          try {
            await saveFileToTransferDB(file);
            const appUrl = dropzone?.getAttribute('data-app-url') || '/app/studio';
            window.location.href = appUrl;
          } catch (err) {
            console.error('File transfer failed, trying sessionStorage fallback', err);
            try {
              const reader = new FileReader();
              reader.onload = (e) => {
                const dataUrl = e.target?.result;
                if (dataUrl) {
                  sessionStorage.setItem('localpdf_transfer_file', JSON.stringify({
                    name: file.name,
                    type: file.type,
                    dataUrl: dataUrl
                  }));
                  const appUrl = dropzone?.getAttribute('data-app-url') || '/app/studio';
                  window.location.href = appUrl;
                }
              };
              reader.readAsDataURL(file);
            } catch (fallbackErr) {
              console.error('Fallback failed', fallbackErr);
              alert('ファイルを読み込めませんでした。もう一度お試しください。');
              if (dropzone) {
                dropzone.classList.remove('uploading');
                const titleEl = dropzone.querySelector('.dropzone-title');
                const subtitleEl = dropzone.querySelector('.dropzone-subtitle');
                if (titleEl) titleEl.textContent = 'ここにPDFファイルをドラッグ＆ドロップ';
                if (subtitleEl) subtitleEl.textContent = 'またはファイルを選択';
              }
            }
          }
        }

        function saveFileToTransferDB(file: File): Promise<void> {
          return new Promise((resolve, reject) => {
            const request = indexedDB.open('localpdf-transfer', 1);
            request.onupgradeneeded = () => {
              const db = request.result;
              if (!db.objectStoreNames.contains('transfer-files')) {
                db.createObjectStore('transfer-files', { keyPath: 'id' });
              }
            };
            request.onsuccess = () => {
              const db = request.result;
              const tx = db.transaction('transfer-files', 'readwrite');
              const store = tx.objectStore('transfer-files');
              const putRequest = store.put({
                id: 'pending',
                blob: file,
                name: file.name,
                type: file.type,
                timestamp: Date.now()
              });
              tx.oncomplete = () => {
                db.close();
                resolve();
              };
              tx.onerror = () => {
                db.close();
                reject(tx.error);
              };
            };
            request.onerror = () => {
              reject(request.error);
            };
          });
        }
      </script>
    </section>

    <!-- ALL UTILITIES toolkit -->
    <section class="section all-tools-section">
      <span class="eyebrow">全ツール一覧</span>
      <h2 class="section-title">お使いのデバイスで完結する安全なPDFツールキット</h2>
      <p class="section-intro">アップロード不要、制限なし、基本機能のサブスク課金なし。ツールをクリックするとキャンバスで直接開きます。</p>
      
      <div class="toolkit-categories">
        {CATEGORIES.map((category) => (
          <div class="toolkit-category">
            <div class="category-header">
              <span class="category-icon" set:html={ICONS[category.icon]} />
              <h3>{category.name}</h3>
            </div>
            <div class="category-tools-list">
              {category.tools.map((tool) => (
                <a href={getToolHref(tool.id)} class="tool-item-link">
                  <div class="tool-item-icon" set:html={ICONS[tool.icon]} />
                  <h4>{tool.name}</h4>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PAIN / RELIEF -->
    <section class="section">
      <span class="eyebrow">従来の方法との違い</span>
      <h2 class="section-title">従来のオンラインツール vs LocalPDF</h2>
      <p class="section-intro">
        PDF間でページを移動したり、ファイルをどこにもアップロードせずに編集したいと思ったことがあるなら — LocalPDFが解決します。
      </p>
      <div class="split-2">
        <div class="pain-card">
          <h3>従来のオンラインPDFツール</h3>
          <ul>
            <li>ファイルをリモートサーバーにアップロード</li>
            <li>操作ごとに別々のページに移動</li>
            <li>抽出ツールと結合ツールを往復する</li>
            <li>アップロードとダウンロードの待ち時間が発生</li>
            <li>相手のプライバシーポリシーを信用するしかない</li>
            <li>複数回の利用にはアカウント作成が必要</li>
          </ul>
        </div>
        <div class="relief-card">
          <h3>LocalPDFの場合</h3>
          <ul>
            <li>デバイスからファイルを開く — アップロードは0バイト</li>
            <li>すべてのツールが1つのキャンバスに、自由に切り替え</li>
            <li>ドキュメント間でページを直接ドラッグ＆ドロップ</li>
            <li>ネットワークの遅延なく、その場で瞬時に処理</li>
            <li>ファイルがデバイス外に出ることは一切ありません</li>
            <li>アカウント不要、サインアップ不要、サブスク登録不要</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="section">
      <span class="eyebrow">使い方</span>
      <h2 class="section-title">開く、編集、保存 — わずか3ステップ</h2>
      <p class="section-intro">アカウント登録もアップロードもサーバーも不要。直感的に使えるシンプルなワークスペース。</p>
      <div class="steps-grid">
        <div class="step">
          <div class="step-num">1</div>
          <h3>PDFを開く</h3>
          <p>PDFをStudioにドラッグするか、デバイスから開きます。ファイルはブラウザのメモリ内にとどまり、どこにも送信されません。オフラインでも動作します。</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>視覚的に作業</h3>
          <p>キャンバス上で、<a href="/features/edit-pdf">テキストの編集</a>、<a href="/features/merge-pdf">ドキュメントの結合</a>、<a href="/features/ocr-pdf">OCRの実行</a>、ドラッグによるページの並べ替えやドキュメント間の移動がすべて行えます。</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>結果を書き出す</h3>
          <p>完成したPDFをダウンロードします。削除手続きも、消去すべきアカウントも、外部サーバーにファイルが残る心配もありません。</p>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section">
      <span class="eyebrow">コア機能</span>
      <h2 class="section-title">よく使われるPDFツール</h2>
