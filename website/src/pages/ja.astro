    box-shadow: var(--shadow);
    padding: 1px;
  }

  .dropzone-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: radial-gradient(circle 160px at var(--mouse-x, 0) var(--mouse-y, 0), #197a5c 0%, rgba(25, 122, 92, 0.4) 50%, transparent 100%);
