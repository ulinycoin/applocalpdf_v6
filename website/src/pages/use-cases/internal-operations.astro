---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getAppUrl } from '../../utils/app-url';

const title = 'PDF workflows for internal operations | LocalPDF';
const description = 'Local-first PDF workflows for internal packets, admin records, OCR, compression, splitting, and document preparation.';
const canonical = 'https://localpdf.online/use-cases/internal-operations';
const image = 'https://localpdf.online/og/home.svg';
const appUrl = getAppUrl();
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image}>
  <div class="page-shell usecase-shell">
    <section class="section hero">
      <span class="eyebrow">Use case</span>
      <h1>Private PDF workflows for internal operations</h1>
      <p class="section-intro">Operations teams constantly handle internal packets, policy documents, signed forms, reports, and admin records. LocalPDF gives those workflows a local-first browser path instead of forcing every file into an upload-first utility flow.</p>
      <div class="cta-row"><a class="btn-primary" href={appUrl}>Open LocalPDF</a><a class="btn-secondary" href="/security">Read Security</a></div>
    </section>
    <section class="section card-grid">
      <article class="card"><h3>Common documents</h3><p>Internal reports, packets, onboarding forms, admin records, policy documents, and approval bundles.</p></article>
      <article class="card"><h3>Common jobs</h3><p>Merge, split, OCR, compress, edit, and prepare PDFs for sharing or archive.</p></article>
      <article class="card"><h3>Why it fits</h3><p>Internal operations work is repetitive, sensitive, and much easier to justify in a local-first workflow.</p></article>
    </section>
  </div>
</MarketingLayout>
<style>.usecase-shell h1{font-size:clamp(3rem,5vw,4.8rem);margin-top:18px;margin-bottom:18px;max-width:11ch;}</style>
