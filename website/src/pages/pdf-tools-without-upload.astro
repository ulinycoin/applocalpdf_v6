---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getAppUrl } from '../utils/app-url';
import { LOCAL_PROCESSING_SCOPE } from '../data/privacy-claims';

const title = 'PDF Tools Without Upload — Local-First Workflows | LocalPDF';
const description = 'Edit, merge, OCR, compress, split, and convert PDFs without uploading. Local workflows in your browser — free to start, Pro for recurring work.';
const canonical = 'https://localpdf.online/pdf-tools-without-upload';
const image = 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const appUrl = getAppUrl();

const toolRows = [
  ['Edit PDF', 'Change text, images, and layout on the page', '/features/edit-pdf'],
  ['Merge PDF', 'Combine documents by dragging pages together', '/features/merge-pdf'],
  ['OCR PDF', 'Extract text from scans with local processing', '/features/ocr-pdf'],
  ['Compress PDF', 'Reduce file size without sending the file to a server queue', '/features/compress-pdf'],
  ['Split PDF', 'Extract or remove pages from any document', '/features/split-pdf'],
  ['Sign PDF', 'Add signatures and complete signing workflows', '/features/sign-pdf'],
  ['Convert PDF', 'PDF ↔ Word, images, and other practical formats', '/features/convert-pdf'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    about: { '@type': 'Thing', name: 'PDF tools without upload' },
  },
];
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image} schema={schema}>
  <div class="page-shell hero-shell">
    <section class="section hero">
      <span class="eyebrow">Category</span>
      <h1>PDF tools without upload-first pressure</h1>
      <p class="section-intro">
        A PDF is often the most complete copy of a document you have: a contract draft, a payroll export, a client
        invoice, an internal record. Uploading it to a stranger's server should not be the default first step. LocalPDF
        keeps the document on your device and gives you one workspace for the whole job — edit, merge, OCR, compress,
        split, sign, and convert.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>Open LocalPDF — free</a>
        <a class="btn-secondary" href="/pricing">See pricing</a>
        <a class="btn-secondary" href="/private-pdf-editor">Private PDF editor</a>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Why upload-first tools are a bad fit for sensitive documents</h2>
      <p>
        Most online PDF brands optimize for convenience: drop a file, wait for a server, download a result. That model
        works for disposable tasks. It breaks down when the PDF is a contract draft, a payroll export, a client invoice,
        or an internal record that should not enter a third-party upload queue by default.
      </p>
      <p>
        The practical question is not "is the vendor trustworthy" but "does the file need to leave at all." When the
        answer is no, working in the browser removes the upload step, the retention question, and the wait. LocalPDF is
        positioned for that: not a generic free online PDF toolbox, but a
        <a href="/private-pdf-editor">private PDF editor</a> with a local-first workflow.
      </p>
    </section>

    <section class="section card-grid">
      <article class="card">
        <h3>Upload-first tools</h3>
        <p>File leaves your device before work starts. Security depends on vendor policies, retention, and jurisdiction.</p>
      </article>
      <article class="card">
        <h3>Local-first workflow</h3>
        <p>Work can start on your device in the browser. Better fit when trust and speed matter together.</p>
      </article>
      <article class="card">
        <h3>When LocalPDF wins</h3>
        <p>Sensitive PDFs, recurring operational work, and teams that need a workspace — not fifty utility bookmarklets.</p>
      </article>
    </section>

    <section class="section">
      <h2 class="section-title">Tools included in LocalPDF</h2>
      <p class="section-intro">
        One workspace covers the jobs people actually stack in a week — not a separate landing page per micro-task.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Tool</th><th>What you can do</th><th>Learn more</th></tr>
          </thead>
          <tbody>
            {toolRows.map((row) => (
              <tr>
                <td>{row[0]}</td>
                <td>{row[1]}</td>
                <td><a href={row[2]}>{row[0]} guide</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Who this is for</h2>
      <div class="card-grid">
        <article class="card">
          <h3><a href="/use-cases/lawyers">Lawyers &amp; legal ops</a></h3>
          <p>Redlines, signatures, and matter files where upload-first handling is hard to justify to clients.</p>
        </article>
        <article class="card">
          <h3><a href="/use-cases/accountants">Accountants &amp; finance</a></h3>
          <p>Invoices, statements, and tax packets that should stay in a controlled local workflow.</p>
        </article>
        <article class="card">
          <h3><a href="/use-cases/hr-sensitive-documents">HR teams</a></h3>
          <p>Employee records and policy PDFs that are sensitive by definition.</p>
        </article>
        <article class="card">
          <h3><a href="/use-cases/internal-operations">Internal operations</a></h3>
          <p>SOPs, vendor PDFs, and ops documentation processed every week.</p>
        </article>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">How LocalPDF compares to upload-first suites</h2>
      <p>
        Broad online PDF platforms — including brands like Smallpdf and iLovePDF — excel at tool count and brand reach.
        Their default journey still assumes upload. If you need AI chat over a document in the cloud, those products may
        fit better. If you need a <strong>privacy-first alternative</strong> for day-to-day PDF work, compare:
      </p>
      <ul class="bullet-list compare-links">
        <li><a href="/compare">All PDF tool comparisons</a></li>
        <li><a href="/compare/localpdf-vs-smallpdf">LocalPDF vs Smallpdf</a> — workspace vs utility suite + AI tools</li>
        <li><a href="/compare/localpdf-vs-ilovepdf">LocalPDF vs iLovePDF</a> — local-first vs upload-first ecosystem</li>
        <li><a href="/compare/localpdf-vs-smallpdf-vs-ilovepdf">LocalPDF vs Smallpdf vs iLovePDF</a> — three-way privacy &amp; headers</li>
        <li><a href="/compare/localpdf-vs-pdf24">LocalPDF vs PDF24</a> — browser workspace vs free online toolbox</li>
      </ul>
      <p>
        Read <a href="/how-local-pdf-processing-works">how local PDF processing works</a> and our
        <a href="/security">security overview</a> before you choose a workflow for regulated documents.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Pricing: free to start, Pro for recurring work</h2>
      <div class="card-grid pricing-snapshot">
        <article class="card">
          <h3>Free</h3>
          <p><strong>$0</strong> — every tool, 3 Studio workspaces, 3 downloads per day on your device.</p>
        </article>
        <article class="card">
          <h3>Pro</h3>
          <p><strong>$19 once</strong> (or <strong>$39.99/year</strong>) — unlimited downloads, unlimited workspaces, larger files, full Studio. No subscription required.</p>
        </article>
      </div>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>Use LocalPDF free</a>
        <a class="btn-secondary" href="/pricing">Full pricing</a>
      </div>
    </section>

    <section class="section faq-grid">
      <article class="card">
        <h3>Can I use PDF tools without uploading?</h3>
        <p>{LOCAL_PROCESSING_SCOPE}</p>
      </article>
      <article class="card">
        <h3>Which tools are included?</h3>
        <p>Edit, merge, OCR, compress, split, sign, and convert — in one workspace, not dozens of separate pages.</p>
      </article>
      <article class="card">
        <h3>Is there a free tier?</h3>
        <p>Yes. Upgrade to Pro when PDF work becomes recurring enough to need unlimited workspaces and larger documents.</p>
      </article>
      <article class="card">
        <h3>Who is this for?</h3>
        <p>Legal, finance, HR, and ops teams handling sensitive PDFs — plus privacy-conscious individuals.</p>
      </article>
    </section>
  </div>
</MarketingLayout>

<style>
  .hero-shell h1 {
    font-size: clamp(3rem, 5vw, 4.8rem);
    margin-top: 18px;
    margin-bottom: 18px;
    max-width: 14ch;
  }
  .section p { max-width: 72ch; line-height: 1.65; margin-bottom: 14px; }
  .table-wrap { overflow-x: auto; margin-top: 18px; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border-radius: 18px; overflow: hidden; }
  th, td { border: 1px solid var(--line); padding: 14px; text-align: left; vertical-align: top; }
  th { background: rgba(217, 235, 225, 0.45); }
  .bullet-list { margin: 12px 0 0 1.2rem; line-height: 1.7; }
  .compare-links a { font-weight: 600; }
  .pricing-snapshot { margin-top: 12px; }
  .faq-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
