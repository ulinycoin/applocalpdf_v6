---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Pricing - LocalPDF" 
  description="Simple and transparent pricing for LocalPDF. Choose the plan that works for you."
>
  <main class="pricing-container">
    <header class="pricing-header">
      <h1>Pricing</h1>
      <p class="subtitle">Secure, private, and local-first PDF processing.</p>
    </header>

    <div class="pricing-grid">
      <section class="pricing-card">
        <div class="card-header">
          <h2>Basic</h2>
          <p class="price">$0<span>/forever</span></p>
        </div>
        <ul class="features">
          <li>PDF Merge & Split</li>
          <li>Standard PDF Compression</li>
          <li>Limited page count</li>
          <li>Local-only processing</li>
        </ul>
        <footer class="card-footer">
          <a href="/app" class="btn btn-secondary">Use for Free</a>
        </footer>
      </section>

      <section class="pricing-card featured">
        <div class="card-header">
          <span class="badge">Most Popular</span>
          <h2>Pro Monthly</h2>
          <p class="price">$9<span>/month</span></p>
        </div>
        <ul class="features">
          <li><strong>Everything in Basic</strong></li>
          <li>Advanced OCR (Multi-language)</li>
          <li>Full PDF Editing & Redaction</li>
          <li>High-performance compression</li>
          <li>Unlimited file size/pages</li>
          <li>Priority local worker runtime</li>
        </ul>
        <footer class="card-footer">
          <button id="buy-pro-sub" class="btn btn-primary" data-checkout-url={import.meta.env.VITE_LS_CHECKOUT_URL_PRO_SUB}>
            Get Pro Monthly
          </button>
        </footer>
      </section>

      <section class="pricing-card">
        <div class="card-header">
          <h2>Pro Lifetime</h2>
          <p class="price">$59<span>/once</span></p>
        </div>
        <ul class="features">
          <li><strong>Everything in Pro</strong></li>
          <li>Lifetime updates</li>
          <li>Special early adopter badge</li>
          <li>One-time payment</li>
        </ul>
        <footer class="card-footer">
          <button id="buy-pro-lifetime" class="btn btn-secondary" data-checkout-url={import.meta.env.VITE_LS_CHECKOUT_URL_PRO_LIFETIME}>
           Buy Once
          </button>
        </footer>
      </section>
    </div>

    <section class="restore-section">
      <h3>Already have a license?</h3>
      <p>Enter your license key to restore your Pro status.</p>
      <div class="restore-form">
        <input type="text" id="license-key-input" placeholder="Your LemonSqueezy License Key" autocomplete="off" spellcheck="false" />
        <button id="restore-license-btn" class="btn btn-outline">Restore</button>
      </div>
      <p id="restore-status" class="status-message"></p>
    </section>
  </main>
</Layout>

<script>
  import { openCheckout, resolveCheckoutUrl } from '../../src/app/react/billing';
  import { BillingService } from '../../src/app/platform/billing-service';

  const billingService = new BillingService('v6_subscription_jwt', import.meta.env.VITE_PUBLIC_JWT_KEY);

  function setupCheckout(buttonId: string) {
    const btn = document.getElementById(buttonId);
    if (!btn) return;

    const checkoutUrl = resolveCheckoutUrl(btn.getAttribute('data-checkout-url') ?? undefined);
    btn.addEventListener('click', () => {
      if (checkoutUrl) {
        openCheckout(checkoutUrl);
      } else {
        console.error('Missing or invalid LemonSqueezy checkout URL');
        alert('Billing configuration is missing. Please contact support.');
      }
    });
  }

  setupCheckout('buy-pro-sub');
  setupCheckout('buy-pro-lifetime');

  const restoreBtn = document.getElementById('restore-license-btn');
  const licenseInput = document.getElementById('license-key-input') as HTMLInputElement;
  const statusMsg = document.getElementById('restore-status');

  restoreBtn?.addEventListener('click', async () => {
    const key = licenseInput?.value?.trim();
    if (!key) return;

    restoreBtn.toggleAttribute('disabled', true);
    if (statusMsg) {
      statusMsg.className = 'status-message';
      statusMsg.textContent = 'Restoring...';
    }

    try {
      const response = await fetch('/api/billing/restore', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ licenseKey: key }),
      });

      const data = await response.json();
      if (response.ok && data.token) {
        const saved = await billingService.saveToken(data.token);
        if (!saved) {
          throw new Error('Failed to verify subscription token locally');
        }
        if (statusMsg) {
          statusMsg.className = 'status-message success';
          statusMsg.textContent = 'License restored successfully! Redirecting to app...';
        }
        setTimeout(() => {
          window.location.assign('/app');
        }, 2000);
      } else {
        throw new Error(data.error || 'Failed to restore license');
      }
    } catch (err: any) {
      if (statusMsg) {
        statusMsg.className = 'status-message error';
        statusMsg.textContent = err.message;
      }
    } finally {
      restoreBtn.toggleAttribute('disabled', false);
    }
  });
</script>

<style>
  .pricing-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 80px 24px;
    font-family: 'Inter', system-ui, sans-serif;
  }
  .pricing-header { text-align: center; margin-bottom: 64px; }
  .pricing-header h1 { font-size: 48px; font-weight: 800; margin-bottom: 16px; background: linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .subtitle { font-size: 20px; color: #666; }
  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-bottom: 80px; }
  @media (max-width: 900px) { .pricing-grid { grid-template-columns: 1fr; } }
  .pricing-card { background: white; border: 1px solid #e5e7eb; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; transition: all 0.3s ease; position: relative; }
  .pricing-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05); border-color: #d1d5db; }
  .pricing-card.featured { border: 2px solid #000; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.1); }
  .badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #000; color: white; padding: 6px 16px; border-radius: 999px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .card-header { margin-bottom: 32px; }
  .card-header h2 { font-size: 32px; font-weight: 700; margin-bottom: 12px; }
  .price { font-size: 48px; font-weight: 800; color: #111; }
  .price span { font-size: 18px; font-weight: 500; color: #6b7280; }
  .features { list-style: none; padding: 0; margin: 0 0 32px 0; flex: 1; }
  .features li { padding: 12px 0; border-bottom: 1px solid #f3f4f6; color: #374151; }
  .features li:last-child { border-bottom: none; }
  .card-footer { margin-top: auto; }
  .btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; padding: 14px 24px; border-radius: 14px; font-weight: 600; text-decoration: none; cursor: pointer; transition: all 0.2s ease; border: none; }
  .btn-primary { background: #111; color: white; }
  .btn-primary:hover { background: #000; }
  .btn-secondary { background: #f3f4f6; color: #111; }
  .btn-secondary:hover { background: #e5e7eb; }
  .btn-outline { background: transparent; border: 1px solid #d1d5db; color: #111; }
  .btn-outline:hover { background: #f9fafb; }
  .restore-section { max-width: 680px; margin: 0 auto; text-align: center; padding: 48px 32px; background: #f9fafb; border-radius: 24px; border: 1px solid #e5e7eb; }
  .restore-section h3 { font-size: 30px; margin-bottom: 12px; }
  .restore-form { display: flex; gap: 12px; margin-top: 24px; }
  @media (max-width: 640px) { .restore-form { flex-direction: column; } }
  .restore-form input { flex: 1; padding: 14px 16px; border-radius: 14px; border: 1px solid #d1d5db; font-size: 16px; }
  .status-message { min-height: 24px; margin-top: 16px; }
  .status-message.success { color: #166534; }
  .status-message.error { color: #b91c1c; }
</style>
