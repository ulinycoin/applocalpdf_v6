---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getAppUrl } from '../utils/app-url';

const title = 'About | LocalPDF';
const description = 'LocalPDF is a privacy-first PDF app focused on clear workflows, local-first handling, and a smaller set of strong product pages.';
const canonical = 'https://localpdf.online/about';
const image = 'https://localpdf.online/og/home.svg';
const appUrl = getAppUrl();
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image}>
  <div class="page-shell">
    <section class="section intro">
      <span class="eyebrow">About</span>
      <h1>LocalPDF is built to feel like a product, not a directory of PDF tools</h1>
      <p class="section-intro">
        LocalPDF exists for practical PDF work that should stay closer to the user and the file.
        The product direction is simple: reduce page sprawl, explain the workflow clearly, and treat
        trust as part of the main experience instead of an afterthought.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">What LocalPDF is optimizing for</h2>
      <div class="card-grid">
        <div class="card">
          <h3>Practical PDF jobs</h3>
          <p>Edit, merge, OCR, compress, split, sign, and convert workflows should be easy to find and easy to start.</p>
        </div>
        <div class="card">
          <h3>Local-first handling</h3>
          <p>The product should give users a workflow that begins on their device when the document is sensitive or operationally important.</p>
        </div>
        <div class="card">
          <h3>Clear product structure</h3>
          <p>A smaller set of stronger pages is easier to trust, easier to maintain, and easier to understand than a large tail of weak routes.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Core principles</h2>
      <div class="principles">
        <article class="principle">
          <strong>Trust should sound factual</strong>
          <p>Privacy and security claims should stay inside what the product can defend clearly.</p>
        </article>
        <article class="principle">
          <strong>The app is the center</strong>
          <p>Marketing pages exist to explain the workflows and remove hesitation before the click, not to replace the product.</p>
        </article>
        <article class="principle">
          <strong>Compact beats sprawling</strong>
          <p>One strong canonical page per workflow is a better system than dozens of overlapping routes with thin copy.</p>
        </article>
      </div>
    </section>

    <section class="section final-band">
      <div>
        <span class="eyebrow">Next step</span>
        <h2 class="section-title">Use the trust pages to judge the product honestly</h2>
        <p class="section-intro">
          The homepage explains the product. The feature pages explain the jobs. FAQ and Security explain the trust boundary.
        </p>
      </div>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
        <a class="btn-secondary" href="/security">Read Security</a>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .intro h1 {
    font-size: clamp(3rem, 5vw, 5rem);
    margin-top: 18px;
    margin-bottom: 18px;
    max-width: 11ch;
  }

  .principles {
    display: grid;
    gap: 14px;
  }

  .principle {
    padding: 20px 22px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .principle strong {
    display: block;
    margin-bottom: 8px;
    font-size: 1.05rem;
  }

  .final-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
</style>
