---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { featurePages } from '../data/featurePages';
import { getAppUrl } from '../utils/app-url';
import { CATEGORIES, ICONS } from '../data/tools';

function getToolHref(toolId: string): string {
  const mapping: Record<string, string> = {
    'edit-text-pdf': '/features/edit-pdf',
    'add-text-pdf': '/features/edit-pdf',
    'sign-pdf': '/features/sign-pdf',
    'add-form-fields-pdf': '/features/edit-pdf',
    'watermark-pdf': '/features/edit-pdf',
    'flatten-pdf': '/features/edit-pdf',
    
    'merge-pdf': '/features/merge-pdf',
    'split-pdf': '/features/split-pdf',
    'compress-pdf': '/features/compress-pdf',
    'auto-toc-pdf': '/features/auto-toc-pdf',
    'organize-pdf': '/features/split-pdf',
    'rotate-pdf': '/features/split-pdf',
    'delete-pages-pdf': '/features/split-pdf',
    'extract-pages-pdf': '/features/split-pdf',
    
    'tables-pdf': '/features/convert-pdf',
    'ocr-pdf': '/features/ocr-pdf',
    'pdf-to-word': '/features/convert-pdf',
    'word-to-pdf': '/features/convert-pdf',
    'images-to-pdf': '/features/convert-pdf',
    'pdf-to-images': '/features/convert-pdf',
    'extract-images-pdf': '/features/convert-pdf',
    
    'protect-pdf': '/features/edit-pdf'
  };
  return mapping[toolId] || '/';
}

const title = '浏览器内私密PDF编辑器 — 独立编辑、合并及OCR | LocalPDF';
const description = '在浏览器中私密地编辑、合并、OCR、压缩、拆分和转换PDF。零上传，无服务器存储，支持离线使用。打开 LocalPDF — 完全免费。';
const canonical = 'https://localpdf.online/zh';
const image = 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const imageAlt = 'LocalPDF — private PDF editor that runs entirely in your browser';
const appUrl = getAppUrl(undefined, { upload: '1' });

const homepageFaqs = [
  {
    question: '使用 LocalPDF 需要上传我的PDF吗？',
    answer: '不需要。LocalPDF 完全在您的浏览器中运行。您只需从设备中打开文件、进行编辑，然后下载结果 — 没有任何内容会被上传到任何服务器。',
  },
  {
    question: '我真的可以在不同的PDF之间拖动页面吗？',
    answer: '是的。在画布上并排打开两个PDF，选择其中一个页面，然后拖动到另一个PDF中。页面会瞬间复制 — 无需经历先提取再合并的繁琐过程。',
  },
  {
    question: 'LocalPDF 真的免费吗？有什么限制吗？',
    answer: '是的，PDF编辑、合并、OCR、压缩、拆分和转换这六大核心工具完全免费。针对重度用户，我们提供解锁更高工作区限制的 Pro 计划（每月 $3.99），但免费使用没有任何试用期限、没有任何基础功能限制，也无需绑定信用卡。',
  },
  {
    question: '这与 Smallpdf 或 Adobe Acrobat 有何不同？',
    answer: '有两个核心区别。首先，LocalPDF 将一切保留在您的本地设备上 — 无需上传，无服务器存储，您无需去信任任何第三方的隐私政策。其次，LocalPDF 采用可视化画布设计，您可以并排处理多个文档并在它们之间拖放页面，而不是像传统工具那样每次操作都要单独上传文件。',
  },
  {
    question: '无网络连接时 LocalPDF 还能工作吗？',
    answer: '是的。在初始页面加载后，所有处理均通过 WebAssembly 在您的浏览器中本地运行。您可以在飞机上、火车上或任何没有网络连接的地方编辑、合并、OCR、压缩、拆分和转换PDF。',
  },
  {
    question: 'LocalPDF 支持哪些浏览器？',
    answer: 'LocalPDF 支持 Chrome、Firefox、Safari 和 Edge。所有处理均使用 WebAssembly，因此无需安装任何插件或软件。您还可以通过 PWA 提示将其安装为 Chrome 应用以便快速访问。',
  },
];

const websiteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'LocalPDF',
    url: canonical,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'LocalPDF',
    url: canonical,
    logo: 'https://localpdf.online/logos/localpdf-header-96x96.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'LocalPDF',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: canonical,
    description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      '本地编辑PDF，无需上传',
      '在同一个工作区中合并PDF文件',
      '在本地对扫描的PDF运行OCR',
      '在文档之间拖放页面',
      '无需网络，支持离线工作',
      '压缩、拆分、签名和转换PDF',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homepageFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
];

const popularGuides = [
  {
    href: '/blog/how-to-merge-pdf-files',
    title: '如何合并PDF文件',
    description: '直接合并多个PDF为一个文档，无需上传到任何地方。',
  },
  {
    href: '/blog/edit-text-in-pdf-guide',
    title: '如何编辑PDF中的文本',
    description: '直接编辑PDF文本 — 修改字词、遮盖敏感内容等。',
  },
  {
    href: '/blog/ocr-pdf-extract-text',
    title: 'PDF OCR: 从扫描件中提取文本',
    description: '将扫描版PDF转换为可搜索的文档 — 完全本地处理，无需上传。',
  },
];

const hreflangs = [
  { hreflang: 'en', href: 'https://localpdf.online/' },
  { hreflang: 'ja', href: 'https://localpdf.online/ja' },
  { hreflang: 'zh', href: 'https://localpdf.online/zh' },
  { hreflang: 'x-default', href: 'https://localpdf.online/' }
];
---

<MarketingLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  schema={websiteSchema}
  hreflangs={hreflangs}
  lang="zh"
>
  <div class="page-shell">

    <!-- HERO -->
    <section class="hero section">
      <div class="hero-copy">
        <span class="eyebrow">私密PDF编辑器 — 100% 本地处理</span>
        <h1>在浏览器中轻松编辑、合并和OCR处理PDF</h1>
        <p class="hero-text">
          完全在您的设备上运行的完整PDF工作区。编辑文本、合并文档、在扫描件上运行OCR、压缩、拆分和转换 — 零上传，无服务器存储，并支持完整的离线工作。可以像在桌面上整理纸张一样直观地拖放页面。
        </p>
        <div class="hero-price">免费使用 — 无需注册账户</div>
        <div class="cta-row">
          <a href={appUrl} class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            打开 LocalPDF — 完全免费
          </a>
          <a href="#how-it-works" class="btn-secondary">工作原理</a>
        </div>
        <div class="hero-trust">
          <span class="tag">0 字节上传</span>
          <span class="tag">支持离线</span>
          <span class="tag">无需账户</span>
          <span class="tag">适用于法律、财务和人力资源团队</span>
        </div>
      </div>

      <div class="dropzone-card" id="dropzone" data-app-url={appUrl}>
        <div class="dropzone-inner-wrapper">
          <div class="dropzone-grid-bg"></div>
          <div class="dropzone-grid-highlight"></div>
          <div class="dropzone-content">
            <div class="dropzone-icon-container">
              <div class="simple-doc-wrapper">
                <div class="simple-doc">
                  <div class="simple-doc-fold"></div>
                  <div class="simple-doc-lines">
                    <div class="simple-doc-line" style="width: 80%;"></div>
                    <div class="simple-doc-line" style="width: 60%;"></div>
                    <div class="simple-doc-line" style="width: 70%;"></div>
                  </div>
                  <div class="simple-doc-tag">PDF</div>
                </div>
                <div class="simple-doc-shadow"></div>
              </div>
            </div>
            <div class="dropzone-text-group">
              <strong class="dropzone-title">拖放您的PDF到这里</strong>
              <span class="dropzone-subtitle">或点击选择文件</span>
              <span class="dropzone-hint">标准文档免费试用 &bull; 无需信用卡</span>
            </div>
            <span class="dropzone-privacy-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              100% 本地与私密
            </span>
          </div>
        </div>
        <input type="file" id="dropzone-file-input" accept=".pdf" style="display: none;" />
      </div>

      <script>
        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('dropzone-file-input') as HTMLInputElement | null;

        if (dropzone && fileInput) {
          dropzone.addEventListener('click', () => {
            fileInput.click();
          });

          fileInput.addEventListener('change', () => {
            const files = fileInput.files;
            if (files && files.length > 0) {
              void handleFileTransfer(files[0]);
            }
          });

          dropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropzone.classList.add('dragover');
          });

          dropzone.addEventListener('dragleave', () => {
            dropzone.classList.remove('dragover');
          });

          dropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropzone.classList.remove('dragover');
            const files = e.dataTransfer?.files;
            if (files && files.length > 0) {
              const file = files[0];
              if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
                void handleFileTransfer(file);
              } else {
                alert('请选择PDF文件。');
              }
            }
          });

          let mouseX = 0;
          let mouseY = 0;
          let targetX = 0;
          let targetY = 0;
          let isHovered = false;
          let frameId = 0;

          function tick() {
            if (!isHovered) return;
            mouseX += (targetX - mouseX) * 0.08;
            mouseY += (targetY - mouseY) * 0.08;
            dropzone.style.setProperty('--mouse-x', `${mouseX}px`);
            dropzone.style.setProperty('--mouse-y', `${mouseY}px`);
            frameId = requestAnimationFrame(tick);
          }

          dropzone.addEventListener('mouseenter', (e) => {
            isHovered = true;
            const rect = dropzone.getBoundingClientRect();
            targetX = e.clientX - rect.left;
            targetY = e.clientY - rect.top;
            mouseX = targetX;
            mouseY = targetY;
            cancelAnimationFrame(frameId);
            tick();
          });

          dropzone.addEventListener('mousemove', (e) => {
            const rect = dropzone.getBoundingClientRect();
            targetX = e.clientX - rect.left;
            targetY = e.clientY - rect.top;
          });

          dropzone.addEventListener('mouseleave', () => {
            isHovered = false;
            cancelAnimationFrame(frameId);
          });

          // Create a premium full-screen drag overlay
          const overlay = document.createElement('div');
          overlay.id = 'window-drag-overlay';
          Object.assign(overlay.style, {
            position: 'fixed',
            inset: '0',
            zIndex: '99999',
            backgroundColor: 'rgba(21, 34, 27, 0.88)',
            backdropFilter: 'blur(12px)',
            webkitBackdropFilter: 'blur(12px)',
            display: 'none',
            alignItems: 'center',
            justifyContent: 'center',
            color: '#ffffff',
            transition: 'opacity 0.25s cubic-bezier(0.25, 0.8, 0.25, 1)',
            opacity: '0',
            pointerEvents: 'none'
          });

          overlay.innerHTML = `
            <div style="
              border: 1.5px dashed rgba(80, 184, 108, 0.5);
              border-radius: 28px;
              padding: 48px 32px;
              text-align: center;
              max-width: 440px;
              width: 90%;
              display: flex;
              flex-direction: column;
              align-items: center;
              gap: 20px;
              background: rgba(15, 27, 35, 0.7);
              box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            ">
              <div style="
                width: 72px;
                height: 72px;
                background: rgba(80, 184, 108, 0.12);
                border: 1px solid rgba(80, 184, 108, 0.3);
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
                animation: floatDoc 2.4s ease-in-out infinite;
              ">📄</div>
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <strong style="
                  font-size: 1.45rem;
                  font-family: 'Iowan Old Style', Georgia, serif;
                  font-weight: 700;
                  color: #eaf8ee;
                ">将PDF拖放到任意位置</strong>
                <span style="
                  font-size: 0.92rem;
                  color: #a5d6a7;
                  font-weight: 500;
                  opacity: 0.9;
                ">即可直接加载到安全的本地工作区中</span>
              </div>
            </div>
          `;
          document.body.appendChild(overlay);

          let dragCounter = 0;

          window.addEventListener('dragenter', (e) => {
            const types = e.dataTransfer?.types;
            const hasFiles = types && Array.from(types).includes('Files');
            if (!hasFiles) return;

            e.preventDefault();
            dragCounter++;
            if (dragCounter === 1) {
              overlay.style.display = 'flex';
              // Force reflow
              overlay.offsetHeight;
              overlay.style.opacity = '1';
            }
          });

          window.addEventListener('dragover', (e) => {
            e.preventDefault();
          });

          window.addEventListener('dragleave', (e) => {
            dragCounter--;
            if (dragCounter === 0) {
              overlay.style.opacity = '0';
              setTimeout(() => {
                if (dragCounter === 0) overlay.style.display = 'none';
              }, 250);
            }
          });

          window.addEventListener('drop', (e) => {
            e.preventDefault();
            dragCounter = 0;
            overlay.style.opacity = '0';
            overlay.style.display = 'none';

            const files = e.dataTransfer?.files;
            if (files && files.length > 0) {
              const file = files[0];
              if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
                void handleFileTransfer(file);
              } else {
                alert('请选择PDF文件。');
              }
            }
          });
        }

        async function handleFileTransfer(file: File) {
          if (dropzone) {
            dropzone.classList.add('uploading');
            const titleEl = dropzone.querySelector('.dropzone-title');
            const subtitleEl = dropzone.querySelector('.dropzone-subtitle');
            if (titleEl) titleEl.textContent = '正在加载文件...';
            if (subtitleEl) subtitleEl.textContent = file.name;
          }

          try {
            await saveFileToTransferDB(file);
            const appUrl = dropzone?.getAttribute('data-app-url') || '/app/studio';
            window.location.href = appUrl;
          } catch (err) {
            console.error('File transfer failed, trying sessionStorage fallback', err);
            try {
              const reader = new FileReader();
              reader.onload = (e) => {
                const dataUrl = e.target?.result;
                if (dataUrl) {
                  sessionStorage.setItem('localpdf_transfer_file', JSON.stringify({
                    name: file.name,
                    type: file.type,
                    dataUrl: dataUrl
                  }));
                  const appUrl = dropzone?.getAttribute('data-app-url') || '/app/studio';
                  window.location.href = appUrl;
                }
              };
              reader.readAsDataURL(file);
            } catch (fallbackErr) {
              console.error('Fallback failed', fallbackErr);
              alert('无法加载文件。请重试。');
              if (dropzone) {
                dropzone.classList.remove('uploading');
                const titleEl = dropzone.querySelector('.dropzone-title');
                const subtitleEl = dropzone.querySelector('.dropzone-subtitle');
                if (titleEl) titleEl.textContent = '拖放您的PDF到这里';
                if (subtitleEl) subtitleEl.textContent = '或点击选择文件';
              }
            }
          }
        }

        function saveFileToTransferDB(file: File): Promise<void> {
          return new Promise((resolve, reject) => {
            const request = indexedDB.open('localpdf-transfer', 1);
            request.onupgradeneeded = () => {
              const db = request.result;
              if (!db.objectStoreNames.contains('transfer-files')) {
                db.createObjectStore('transfer-files', { keyPath: 'id' });
              }
            };
            request.onsuccess = () => {
              const db = request.result;
              const tx = db.transaction('transfer-files', 'readwrite');
              const store = tx.objectStore('transfer-files');
              const putRequest = store.put({
                id: 'pending',
                blob: file,
                name: file.name,
                type: file.type,
                timestamp: Date.now()
              });
              tx.oncomplete = () => {
                db.close();
                resolve();
              };
              tx.onerror = () => {
                db.close();
                reject(tx.error);
              };
            };
            request.onerror = () => {
              reject(request.error);
            };
          });
        }
      </script>
    </section>

    <!-- ALL UTILITIES toolkit -->
    <section class="section all-tools-section">
      <span class="eyebrow">所有工具</span>
      <h2 class="section-title">设备上完整的私密PDF工具包</h2>
      <p class="section-intro">无上传、无限制、基础功能无订阅收费。点击任意工具直接在画布中打开。</p>
      
      <div class="toolkit-categories">
        {CATEGORIES.map((category) => (
          <div class="toolkit-category">
            <div class="category-header">
              <span class="category-icon" set:html={ICONS[category.icon]} />
              <h3>{category.name}</h3>
            </div>
            <div class="category-tools-list">
              {category.tools.map((tool) => (
                <a href={getToolHref(tool.id)} class="tool-item-link">
                  <div class="tool-item-icon" set:html={ICONS[tool.icon]} />
                  <h4>{tool.name}</h4>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PAIN / RELIEF -->
    <section class="section">
      <span class="eyebrow">对比与改变</span>
      <h2 class="section-title">传统方式与 LocalPDF 方式</h2>
      <p class="section-intro">
        如果您曾需要在PDF之间移动页面，或者只想编辑文档而不将其上传到任何地方 — 看看体验有何不同。
      </p>
      <div class="split-2">
        <div class="pain-card">
          <h3>传统的在线PDF工具</h3>
          <ul>
            <li>将文件上传到远程服务器</li>
            <li>每个操作都需要使用单独的页面</li>
            <li>用一个工具提取页面，再用另一个工具合并</li>
            <li>必须等待每次上传和下载</li>
            <li>必须接受并信任他们的隐私政策</li>
            <li>限制使用次数，要求创建账户</li>
          </ul>
        </div>
        <div class="relief-card">
          <h3>使用 LocalPDF</h3>
          <ul>
            <li>直接从设备打开文件 — 零上传</li>
            <li>所有工具集中在单个画布，自由切换</li>
            <li>直接在文档之间拖动页面</li>
            <li>即时响应，无需经过网络传输</li>
            <li>任何数据绝不会离开您的设备</li>
            <li>无需账户，无需注册，无订阅门槛</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="section">
      <span class="eyebrow">工作原理</span>
      <h2 class="section-title">打开、操作、导出 — 仅需三步</h2>
      <p class="section-intro">无账户、无上传、无服务器。一个完全符合您预期的工作区。</p>
      <div class="steps-grid">
        <div class="step">
          <div class="step-num">1</div>
          <h3>打开PDF</h3>
          <p>将任何PDF拖入 Studio 或从您的设备中打开。文件保存在浏览器内存中 — 零字节发送到外部。离线也能用。</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>直观可视化操作</h3>
          <p>在画布上直接<a href="/features/edit-pdf">编辑文本</a>、<a href="/features/merge-pdf">合并文档</a>、<a href="/features/ocr-pdf">运行OCR</a>、通过拖拽对页面排序或在打开的PDF之间移动页面。</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>导出结果</h3>
          <p>下载处理好的PDF。无需清理缓存，无需注销账户，更没有文件被遗留在别人的服务器上。</p>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section">
      <span class="eyebrow">核心功能</span>
      <h2 class="section-title">最常用的PDF工具</h2>
      <p class="section-intro">最常用的六大工具集成于一体。无需离开文档即可在它们之间随时切换。</p>
      <div class="feat-grid">
        <a href="/features/edit-pdf" class="feat-card">
          <div class="feat-icon">✎</div>
          <div><h3>编辑PDF</h3><p>直接在页面上编辑文本和图像</p></div>
        </a>
        <a href="/features/merge-pdf" class="feat-card">
          <div class="feat-icon">⊞</div>
          <div><h3>合并PDF</h3><p>通过拖放页面将文档组合在一起</p></div>
        </a>
        <a href="/features/ocr-pdf" class="feat-card">
          <div class="feat-icon">◎</div>
          <div><h3>PDF OCR</h3><p>从扫描文档中提取文本（本地处理）</p></div>
        </a>
        <a href="/features/compress-pdf" class="feat-card">
          <div class="feat-icon">▼</div>
