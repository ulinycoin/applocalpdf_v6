---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getAppUrl } from '../../utils/app-url';

const title = 'LocalPDF vs PDF24 | Privacy-first browser workflow vs utility toolkit';
const description = 'Compare LocalPDF vs PDF24 for workflow style and which one makes more sense for sensitive documents, internal records, and browser-based PDF work.';
const canonical = 'https://localpdf.online/compare/localpdf-vs-pdf24';
const image = 'https://localpdf.online/logos/localpdf-social-1200x630.png';
const appUrl = getAppUrl();

const comparisonRows = [
  ['Category focus', 'Browser-based local-first workflow', 'Traditional utility toolkit'],
  ['Primary strengths', 'Privacy-first positioning', 'Utility breadth and free-tool coverage'],
  ['Best for', 'Contracts, invoices, internal records', 'General everyday PDF tasks'],
];
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image}>
  <div class="page-shell compare-shell">
    <section class="section hero">
      <span class="eyebrow">Comparison</span>
      <h1>LocalPDF vs PDF24</h1>
      <p class="section-intro">PDF24 is a broad utility toolkit with strong free-tool coverage. LocalPDF is a more opinionated privacy-first product for users who want local-first browser workflows for sensitive PDF work.</p>
      <div class="cta-row"><a class="btn-primary" href={appUrl}>Open LocalPDF</a><a class="btn-secondary" href="/private-pdf-editor">Private PDF editor</a></div>
    </section>
    <section class="section">
      <h2 class="section-title">Quick comparison</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Feature</th><th>LocalPDF</th><th>PDF24</th></tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <td>{row[0]}</td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    <section class="section card-grid">
      <article class="card"><h3>Main difference</h3><p>PDF24 wins on utility breadth; LocalPDF wins on privacy-first browser workflow positioning.</p></article>
    </section>
  </div>
</MarketingLayout>
<style>
  .compare-shell h1{font-size:clamp(3rem,5vw,4.8rem);margin-top:18px;margin-bottom:18px;}
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border-radius: 18px; overflow: hidden; }
  th, td { border: 1px solid var(--line); padding: 14px; text-align: left; vertical-align: top; }
  th { background: rgba(217, 235, 225, 0.45); }
</style>
