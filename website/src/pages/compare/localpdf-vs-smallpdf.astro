---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getAppUrl } from '../../utils/app-url';

const title = 'LocalPDF vs Smallpdf | Privacy-first PDF workflow comparison';
const description = 'Compare LocalPDF vs Smallpdf for privacy, file handling, workflow clarity, and fit for contracts, invoices, and sensitive PDFs.';
const canonical = 'https://localpdf.online/compare/localpdf-vs-smallpdf';
const image = 'https://localpdf.online/og/home.svg';
const appUrl = getAppUrl();

const comparisonRows = [
  ['Primary model', 'Local-first PDF workspace in the browser', 'Upload-first online PDF utility suite'],
  ['Best fit', 'Sensitive PDF work, contracts, invoices, internal records', 'General-purpose online PDF tasks at scale'],
  ['How work starts', 'Core workflows can start on the user device', 'Common workflows start with file upload'],
  ['Trust narrative', 'Reduce exposure by avoiding an upload-first handoff', 'Protect uploaded files with security controls and deletion policies'],
  ['Workflow shape', 'Workspace-style product path', 'Large utility-page network'],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'When is LocalPDF a better fit than Smallpdf?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'LocalPDF is a better fit when the file is sensitive and the user wants a privacy-first workflow that can start locally in the browser instead of with an upload-first handoff.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the biggest difference between LocalPDF and Smallpdf?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The biggest difference is workflow philosophy: LocalPDF emphasizes local-first processing for practical PDF jobs, while Smallpdf is built around a broad online utility suite with upload-first expectations.',
      },
    },
  ],
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: canonical,
    author: { '@type': 'Organization', name: 'LocalPDF' },
    publisher: { '@type': 'Organization', name: 'LocalPDF' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://localpdf.online/' },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: 'https://localpdf.online/compare/localpdf-vs-smallpdf' },
      { '@type': 'ListItem', position: 3, name: 'LocalPDF vs Smallpdf', item: canonical },
    ],
  },
  faqSchema,
];
---

<MarketingLayout title={title} description={description} canonical={canonical} image={image} schema={schema}>
  <div class="page-shell compare-shell">
    <section class="section hero">
      <span class="eyebrow">Comparison</span>
      <h1>LocalPDF vs Smallpdf</h1>
      <p class="section-intro">
        Both products help users finish PDF jobs. The difference is where the workflow begins and what kind of
        trust model the user wants. LocalPDF is the stronger fit when the file is sensitive and the user wants a
        privacy-first PDF editor with a local-first browser workflow.
      </p>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
        <a class="btn-secondary" href="/security">Read Security</a>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Quick comparison</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Area</th><th>LocalPDF</th><th>Smallpdf</th></tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <td>{row[0]}</td>
                <td>{row[1]}</td>
                <td>{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section card-grid">
      <article class="card">
        <h3>Choose LocalPDF when</h3>
        <ul class="bullet-list">
          <li>You work with contracts, invoices, internal records, or other sensitive PDFs.</li>
          <li>You want a local-first workflow that can start on the user device.</li>
          <li>You prefer a product workspace over a maze of utility pages.</li>
        </ul>
      </article>
      <article class="card">
        <h3>Choose Smallpdf when</h3>
        <ul class="bullet-list">
          <li>You need a broad online utility suite and already accept upload-first handling.</li>
          <li>You optimize for tool breadth before workflow trust.</li>
          <li>You want a widely known general-purpose PDF brand.</li>
        </ul>
      </article>
      <article class="card">
        <h3>Main takeaway</h3>
        <p>
          Smallpdf is a broad online PDF platform. LocalPDF is a more opinionated privacy-first alternative for
          users who want practical PDF work to begin locally in the browser.
        </p>
      </article>
    </section>

    <section class="section">
      <h2 class="section-title">Best fit by use case</h2>
      <div class="card-grid">
        <article class="card">
          <h3>Contracts and legal PDFs</h3>
          <p>LocalPDF is easier to justify when contract drafts, signatures, or review copies should stay in a local-first flow.</p>
        </article>
        <article class="card">
          <h3>Invoices and finance files</h3>
          <p>LocalPDF is a stronger fit when invoice packets, receipts, and internal finance PDFs should not start with a remote upload.</p>
        </article>
        <article class="card">
          <h3>Routine disposable tasks</h3>
          <p>Smallpdf may still fit users who prioritize a familiar online utility experience over a privacy-first handling model.</p>
        </article>
      </div>
    </section>

    <section class="section faq-grid">
      <article class="card">
        <h3>When is LocalPDF a better fit than Smallpdf?</h3>
        <p>When the file is sensitive and the user wants a privacy-first workflow that can start locally in the browser.</p>
      </article>
      <article class="card">
        <h3>What is the biggest difference?</h3>
        <p>LocalPDF starts from the file on your device, while Smallpdf is built more like a large online PDF toolbox.</p>
      </article>
      <article class="card">
        <h3>What should users verify?</h3>
        <p>Verify how the workflow starts, what kind of files are involved, and whether an upload-first path is acceptable for that document.</p>
      </article>
    </section>
  </div>
</MarketingLayout>

<style>
  .compare-shell h1 {
    font-size: clamp(3rem, 5vw, 4.8rem);
    margin-top: 18px;
    margin-bottom: 18px;
  }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border-radius: 18px; overflow: hidden; }
  th, td { border: 1px solid var(--line); padding: 14px; text-align: left; vertical-align: top; }
  th { background: rgba(217, 235, 225, 0.45); }
  .faq-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
fr; } }
</style>
