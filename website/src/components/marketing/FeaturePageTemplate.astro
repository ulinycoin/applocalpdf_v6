---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { featurePages, type FeaturePageData } from '../../data/featurePages';
import { getAppUrl } from '../../utils/app-url';

interface Props {
  page: FeaturePageData;
}

const { page } = Astro.props;
const canonical = `https://localpdf.online/features/${page.slug}`;
const appUrl = getAppUrl(page.appHash, { upload: '1' });
const relatedPages = featurePages.filter((item) => item.slug !== page.slug).slice(0, 3);
const howItWorksSchema = page.howItWorks.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to use ${page.eyebrow} in LocalPDF`,
  description: page.metaDescription,
  step: page.howItWorks.map((step, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    text: step,
  })),
} : null;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: page.metaTitle,
    description: page.metaDescription,
    url: canonical,
    isPartOf: {
      '@type': 'WebSite',
      name: 'LocalPDF',
      url: 'https://localpdf.online/',
    },
    about: {
      '@type': 'Thing',
      name: page.eyebrow,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://localpdf.online/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: page.eyebrow,
        item: canonical,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.quickAnswers.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  ...(howItWorksSchema ? [howItWorksSchema] : []),
];
---

<MarketingLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={canonical}
  image={page.socialImage}
  schema={schema}
>
  <div class="page-shell">
    <nav class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <span>{page.eyebrow}</span>
    </nav>
    <section class="feature-hero section">
      <span class="eyebrow">{page.eyebrow}</span>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>{page.title}</h1>
          <p class="hero-intro">{page.intro}</p>
          <div class="cta-row">
            <a class="btn-primary" href={appUrl}>Upload PDF — it stays on your device</a>
            <a class="btn-secondary" href="/security">Read Security Details</a>
          </div>
          <div class="hero-tags">
            <span>{page.eyebrow}</span>
            <span>Local workflow</span>
            <span>Export result</span>
          </div>
        </div>

        <div class="hero-proof">
          <div class="dropzone-card" id="dropzone" data-app-url={appUrl}>
            <div class="dropzone-inner-wrapper">
              <div class="dropzone-grid-bg"></div>
              <div class="dropzone-grid-highlight"></div>
              <div class="dropzone-content">
                <div class="dropzone-icon-container">
                  <div class="simple-doc-wrapper">
                    <div class="simple-doc">
                      <div class="simple-doc-fold"></div>
                      <div class="simple-doc-lines">
                        <div class="simple-doc-line" style="width: 80%;"></div>
                        <div class="simple-doc-line" style="width: 60%;"></div>
                        <div class="simple-doc-line" style="width: 70%;"></div>
                      </div>
                      <div class="simple-doc-tag">PDF</div>
                    </div>
                    <div class="simple-doc-shadow"></div>
                  </div>
                </div>
                <div class="dropzone-text-group">
                  <strong class="dropzone-title">Drag & drop your PDF here</strong>
                  <span class="dropzone-subtitle">or click to choose file</span>
                  <span class="dropzone-hint">Free to try for standard documents &bull; No credit card required</span>
                </div>
                <span class="dropzone-privacy-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  100% Local &amp; Private
                </span>
              </div>
            </div>
            <input type="file" id="dropzone-file-input" accept=".pdf" style="display: none;" />
          </div>
        </div>

        <script>
          const dropzone = document.getElementById('dropzone');
          const fileInput = document.getElementById('dropzone-file-input') as HTMLInputElement | null;

          if (dropzone && fileInput) {
            dropzone.addEventListener('click', () => {
              fileInput.click();
            });

            fileInput.addEventListener('change', () => {
              const files = fileInput.files;
              if (files && files.length > 0) {
                void handleFileTransfer(files[0]);
              }
            });

            dropzone.addEventListener('dragover', (e) => {
              e.preventDefault();
              dropzone.classList.add('dragover');
            });

            dropzone.addEventListener('dragleave', () => {
              dropzone.classList.remove('dragover');
            });

            dropzone.addEventListener('drop', (e) => {
              e.preventDefault();
              dropzone.classList.remove('dragover');
              const files = e.dataTransfer?.files;
              if (files && files.length > 0) {
                const file = files[0];
                if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
                  void handleFileTransfer(file);
                } else {
                  alert('Please upload a PDF file.');
                }
              }
            });

            let mouseX = 0;
            let mouseY = 0;
            let targetX = 0;
            let targetY = 0;
            let isHovered = false;
            let frameId = 0;

            function tick() {
              if (!isHovered) return;
              mouseX += (targetX - mouseX) * 0.08;
              mouseY += (targetY - mouseY) * 0.08;
              dropzone.style.setProperty('--mouse-x', `${mouseX}px`);
              dropzone.style.setProperty('--mouse-y', `${mouseY}px`);
              frameId = requestAnimationFrame(tick);
            }

            dropzone.addEventListener('mouseenter', (e) => {
              isHovered = true;
              const rect = dropzone.getBoundingClientRect();
              targetX = e.clientX - rect.left;
              targetY = e.clientY - rect.top;
              mouseX = targetX;
              mouseY = targetY;
              cancelAnimationFrame(frameId);
              tick();
            });

            dropzone.addEventListener('mousemove', (e) => {
              const rect = dropzone.getBoundingClientRect();
              targetX = e.clientX - rect.left;
              targetY = e.clientY - rect.top;
            });

            dropzone.addEventListener('mouseleave', () => {
              isHovered = false;
              cancelAnimationFrame(frameId);
            });

            // Create a premium full-screen drag overlay
            const overlay = document.createElement('div');
            overlay.id = 'window-drag-overlay';
            Object.assign(overlay.style, {
              position: 'fixed',
              inset: '0',
              zIndex: '99999',
              backgroundColor: 'rgba(21, 34, 27, 0.88)',
              backdropFilter: 'blur(12px)',
              webkitBackdropFilter: 'blur(12px)',
              display: 'none',
              alignItems: 'center',
              justifyContent: 'center',
              color: '#ffffff',
              transition: 'opacity 0.25s cubic-bezier(0.25, 0.8, 0.25, 1)',
              opacity: '0',
              pointerEvents: 'none'
            });

            overlay.innerHTML = `
              <div style="
                border: 1.5px dashed rgba(80, 184, 108, 0.5);
                border-radius: 28px;
                padding: 48px 32px;
                text-align: center;
                max-width: 440px;
                width: 90%;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 20px;
                background: rgba(15, 27, 35, 0.7);
                box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
              ">
                <div style="
                  width: 72px;
                  height: 72px;
                  background: rgba(80, 184, 108, 0.12);
                  border: 1px solid rgba(80, 184, 108, 0.3);
                  border-radius: 20px;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  font-size: 32px;
                  animation: floatDoc 2.4s ease-in-out infinite;
                ">📄</div>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                  <strong style="
                    font-size: 1.45rem;
                    font-family: 'Iowan Old Style', Georgia, serif;
                    font-weight: 700;
                    color: #eaf8ee;
                  ">Drop your PDF anywhere</strong>
                  <span style="
                    font-size: 0.92rem;
                    color: #a5d6a7;
                    font-weight: 500;
                    opacity: 0.9;
                  ">to load it directly into the secure local workspace</span>
                </div>
              </div>
            `;
            document.body.appendChild(overlay);

            let dragCounter = 0;

            window.addEventListener('dragenter', (e) => {
              const types = e.dataTransfer?.types;
              const hasFiles = types && Array.from(types).includes('Files');
              if (!hasFiles) return;

              e.preventDefault();
              dragCounter++;
              if (dragCounter === 1) {
                overlay.style.display = 'flex';
                // Force reflow
                overlay.offsetHeight;
                overlay.style.opacity = '1';
              }
            });

            window.addEventListener('dragover', (e) => {
              e.preventDefault();
            });

            window.addEventListener('dragleave', (e) => {
              dragCounter--;
              if (dragCounter === 0) {
                overlay.style.opacity = '0';
                setTimeout(() => {
                  if (dragCounter === 0) overlay.style.display = 'none';
                }, 250);
              }
            });

            window.addEventListener('drop', (e) => {
              e.preventDefault();
              dragCounter = 0;
              overlay.style.opacity = '0';
              overlay.style.display = 'none';

              const files = e.dataTransfer?.files;
              if (files && files.length > 0) {
                const file = files[0];
                if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
                  void handleFileTransfer(file);
                } else {
                  alert('Please upload a PDF file.');
                }
              }
            });
          }

          async function handleFileTransfer(file: File) {
            if (dropzone) {
              dropzone.classList.add('uploading');
              const titleEl = dropzone.querySelector('.dropzone-title');
              const subtitleEl = dropzone.querySelector('.dropzone-subtitle');
              if (titleEl) titleEl.textContent = 'Loading file...';
              if (subtitleEl) subtitleEl.textContent = file.name;
            }

            try {
              await saveFileToTransferDB(file);
              const appUrl = dropzone?.getAttribute('data-app-url') || '/app/studio';
              window.location.href = appUrl;
            } catch (err) {
              console.error('File transfer failed, trying sessionStorage fallback', err);
              try {
                const reader = new FileReader();
                reader.onload = (e) => {
                  const dataUrl = e.target?.result;
                  if (dataUrl) {
                    sessionStorage.setItem('localpdf_transfer_file', JSON.stringify({
                      name: file.name,
                      type: file.type,
                      dataUrl: dataUrl
                    }));
                    const appUrl = dropzone?.getAttribute('data-app-url') || '/app/studio';
                    window.location.href = appUrl;
                  }
                };
                reader.readAsDataURL(file);
              } catch (fallbackErr) {
                console.error('Fallback failed', fallbackErr);
                alert('Could not load file. Please try again.');
                if (dropzone) {
                  dropzone.classList.remove('uploading');
                  const titleEl = dropzone.querySelector('.dropzone-title');
                  const subtitleEl = dropzone.querySelector('.dropzone-subtitle');
                  if (titleEl) titleEl.textContent = 'Drag & drop your PDF here';
                  if (subtitleEl) subtitleEl.textContent = 'or click to choose file';
                }
              }
            }
          }

          function saveFileToTransferDB(file: File): Promise<void> {
            return new Promise((resolve, reject) => {
              const request = indexedDB.open('localpdf-transfer', 1);
              request.onupgradeneeded = () => {
                const db = request.result;
                if (!db.objectStoreNames.contains('transfer-files')) {
                  db.createObjectStore('transfer-files', { keyPath: 'id' });
                }
              };
              request.onsuccess = () => {
                const db = request.result;
                const tx = db.transaction('transfer-files', 'readwrite');
                const store = tx.objectStore('transfer-files');
                const putRequest = store.put({
                  id: 'pending',
                  blob: file,
                  name: file.name,
                  type: file.type,
                  timestamp: Date.now()
                });
                tx.oncomplete = () => {
                  db.close();
                  resolve();
                };
                tx.onerror = () => {
                  db.close();
                  reject(tx.error);
                };
              };
              request.onerror = () => {
                reject(request.error);
              };
            });
          }
        </script>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">What you can do here</h2>
      <p class="section-intro">
        See what this workflow does, why local handling matters, and where it fits into practical PDF work.
      </p>
      <div class="card-grid">
        <div class="card">
          <h3>Capabilities</h3>
          <ul class="bullet-list">
            {page.capabilities.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="card">
          <h3>Why local matters</h3>
          <ul class="bullet-list">
            {page.whyLocal.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="card">
          <h3>Use cases</h3>
          <ul class="bullet-list">
            {page.useCases.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {page.intentSection && (
      <section class="section">
        <h2 class="section-title">{page.intentSection.title}</h2>
        <p class="section-intro">{page.intentSection.intro}</p>
        <div class="card-grid">
          {page.intentSection.items.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="section outcome-section">
      <div class="outcome-card">
        <small>Best fit</small>
        <strong>{page.eyebrow} works best when the file stays closer to the user</strong>
        <p>{page.proofBody}</p>
      </div>
      <div class="outcome-card soft">
        <small>Why people use it</small>
        <strong>Open LocalPDF when this is the job you actually need to finish</strong>
        <p>{page.ctaNote}</p>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">How it works</h2>
      <div class="steps">
        {page.howItWorks.map((step, index) => (
          <div class="step">
            <span>{index + 1}</span>
            <p>{step}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Questions users ask before they open this workflow</h2>
      <div class="faq-grid">
        {page.quickAnswers.map((item) => (
          <div class="faq-card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        ))}
      </div>
    </section>

    {page.blogLinks && page.blogLinks.length > 0 && (
      <section class="section">
        <h2 class="section-title">Related workflows</h2>
        <p class="section-intro">
          Stay on product pages that open LocalPDF — compare approaches, then finish the job in the app.
        </p>
        <div class="card-grid related-grid">
          {page.blogLinks.map((item) => (
            <a class="related-card" href={item.href}>
              <span class="related-label">Related</span>
              <h3>{item.title}</h3>
              <p>Open the page, then start the workflow in LocalPDF when you are ready.</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {page.monetizationBlock && (
      <section class="section monetization-section">
        <div class="monetization-copy">
          {page.monetizationBlock.eyebrow && <span class="section-eyebrow">{page.monetizationBlock.eyebrow}</span>}
          <h2 class="section-title">{page.monetizationBlock.title}</h2>
          <p class="section-intro">{page.monetizationBlock.body}</p>
        </div>
        <div class="monetization-actions">
          <a class="btn-primary" href="/pricing">{page.monetizationBlock.primaryCtaLabel ?? 'See Pro plans'}</a>
          <a class="btn-secondary" href={appUrl}>{page.monetizationBlock.secondaryCtaLabel ?? 'Open LocalPDF'}</a>
        </div>
      </section>
    )}

    <section class="section objection-section">
      <div class="objection-copy">
        <h2 class="section-title">{page.objectionTitle}</h2>
        <p class="section-intro">{page.objectionBody}</p>
      </div>
      <div class="objection-box">
        <strong>Open LocalPDF when this is the real job</strong>
        <p>{page.ctaNote}</p>
        <div class="cta-row">
          <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
          <a class="btn-secondary" href="/security">Why local matters</a>
        </div>
      </div>
    </section>

    <section class="section final-section">
      <div>
        <h2 class="section-title">{page.proofTitle}</h2>
        <p class="section-intro">{page.proofBody}</p>
      </div>
      <div class="cta-row">
        <a class="btn-primary" href={appUrl}>Open LocalPDF</a>
        <a class="btn-secondary" href="/faq">Read FAQ</a>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Related PDF workflows</h2>
      <p class="section-intro">
        Move between related PDF jobs without starting over. These workflows are part of the same product path.
      </p>
      <div class="card-grid related-grid">
        {relatedPages.map((item) => (
          <a class="related-card" href={`/features/${item.slug}`}>
            <span class="related-label">{item.eyebrow}</span>
            <h3>{item.title}</h3>
            <p>{item.metaDescription}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.92rem;
    color: #536674;
    margin-bottom: 20px;
  }

  .breadcrumbs a {
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
  }

  .feature-hero h1 {
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    margin-top: 18px;
    margin-bottom: 18px;
    max-width: 10ch;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 24px;
    align-items: stretch;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero-intro {
    max-width: 680px;
    font-size: 1.08rem;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-tags span {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 253, 249, 0.9);
    border: 1px solid rgba(20, 32, 40, 0.08);
    color: #344450;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .hero-proof {
    min-height: 100%;
  }

  /* ── Dropzone Card ─────────────────────────── */
  .dropzone-card {
    position: relative;
    height: 100%;
    min-height: 340px;
    border-radius: 20px;
    background: rgba(20, 32, 40, 0.12);
    overflow: hidden;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: var(--shadow);
    padding: 1px;
    width: 100%;
  }

  .dropzone-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: radial-gradient(circle 160px at var(--mouse-x, 0) var(--mouse-y, 0), #197a5c 0%, rgba(25, 122, 92, 0.4) 50%, transparent 100%);
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 1;
  }

  .dropzone-card:hover::before {
    opacity: 1;
  }

  .dropzone-inner-wrapper {
    position: relative;
    height: calc(100% - 2px);
    width: calc(100% - 2px);
    border-radius: 19px;
    background-color: #f3f1ec;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 2;
  }

  .dropzone-grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(20, 32, 40, 0.08) 1.2px, transparent 1.2px);
    background-size: 20px 20px;
    background-position: center;
    transition: all 0.3s ease;
    z-index: 1;
  }

  .dropzone-grid-highlight {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-image: radial-gradient(circle, #197a5c 1.5px, transparent 1.5px);
    background-size: 20px 20px;
    background-position: center;
    mask-image: radial-gradient(circle 100px at var(--mouse-x, 0) var(--mouse-y, 0), black 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle 100px at var(--mouse-x, 0) var(--mouse-y, 0), black 20%, transparent 100%);
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .dropzone-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 32px 24px;
  }

  .dropzone-icon-container {
    position: relative;
    width: 80px;
    height: 85px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }

  .simple-doc-wrapper {
    position: relative;
    width: 80px;
    height: 85px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .simple-doc {
    position: relative;
    width: 52px;
    height: 68px;
    background: #ffffff;
    border: 2px solid var(--text);
    border-radius: 6px;
    clip-path: polygon(0 0, calc(100% - 15px) 0, 100% 15px, 100% 100%, 0 100%);
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    animation: floatDoc 2.4s ease-in-out infinite;
    z-index: 2;
  }

  .simple-doc-fold {
    position: absolute;
    top: 0;
    right: 0;
    width: 15px;
    height: 15px;
    background: #15824c;
    border-radius: 0 4px 0 6px;
    box-shadow: -1.5px 1.5px 3px rgba(0, 0, 0, 0.12);
  }

  .simple-doc-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 8px 8px;
  }

  .simple-doc-line {
    height: 3px;
    background: rgba(20, 32, 40, 0.12);
    border-radius: 1.5px;
  }

  .simple-doc-tag {
    position: absolute;
    bottom: 5px;
    left: 6px;
    background: #15824c;
    color: #ffffff;
    font-size: 7.5px;
    font-weight: 800;
    padding: 1.5px 3px;
    border-radius: 2px;
    line-height: 1;
    font-family: sans-serif;
  }

  .simple-doc-shadow {
    width: 42px;
    height: 4px;
    background: rgba(20, 32, 40, 0.08);
    border-radius: 50%;
    margin-top: 6px;
    filter: blur(1px);
    transition: all 0.35s ease;
    animation: shadowPulse 2.4s ease-in-out infinite;
    z-index: 1;
  }

  .dropzone-text-group {
