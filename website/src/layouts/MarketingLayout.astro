---
import SEOHead from '../components/marketing/SEOHead.astro';
import SiteHeader from '../components/marketing/SiteHeader.astro';
import SiteFooter from '../components/marketing/SiteFooter.astro';
import AnalyticsScripts from '../components/AnalyticsScripts.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  lang?: string;
  hreflangs?: Array<{ hreflang: string; href: string }>;
}

const { title, description, canonical, image, imageAlt, schema, noindex = false, lang = 'en', hreflangs } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      schema={schema}
      noindex={noindex}
      hreflangs={hreflangs}
    />
    <script is:inline>
      (function() {
        // Save current language if it is not default English
        const currentLang = document.documentElement.lang;
        if (currentLang && currentLang !== 'en') {
          localStorage.setItem('localpdf_preferred_lang', currentLang);
        }

        // Auto-redirect if on home page and preferred language is set
        const pref = localStorage.getItem('localpdf_preferred_lang');
        if (pref && pref !== 'en' && (window.location.pathname === '/' || window.location.pathname === '/index.html')) {
          if (pref === 'ja') {
            window.location.replace('/ja');
          } else if (pref === 'zh') {
            window.location.replace('/zh');
          }
        }
      })();
    </script>
    <AnalyticsScripts />
    <slot name="head" />
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f6f3ee;
        --surface: #fffdf9;
        --surface-strong: #fffaf2;
        --text: #142028;
        --text-soft: #52606b;
        --line: rgba(20, 32, 40, 0.09);
        --accent: #de7a2d;
        --accent-soft: #f3c992;
        --mint: #d9ebe1;
        --shadow: 0 16px 40px rgba(26, 34, 39, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: "Avenir Next", "Segoe UI", "Helvetica Neue", sans-serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(243, 201, 146, 0.32), transparent 26%),
          radial-gradient(circle at top right, rgba(217, 235, 225, 0.5), transparent 22%),
          linear-gradient(180deg, #f6f3ee 0%, #f7f4ef 48%, #f1ede6 100%);
      }

      ::selection {
        background: rgba(222, 122, 45, 0.22);
        color: var(--text);
      }

      h1, h2, h3, h4 {
        margin: 0;
        font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
        letter-spacing: -0.03em;
        line-height: 1;
      }

      p {
        margin: 0;
        line-height: 1.65;
        color: var(--text-soft);
      }

      a {
        color: inherit;
      }

      img {
        max-width: 100%;
        display: block;
      }

      main {
        min-height: 70vh;
        padding-top: 12px;
      }

      .page-shell {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px 72px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 36px;
        padding: 0 14px;
        border: 1px solid rgba(20, 32, 40, 0.08);
        border-radius: 999px;
        background: rgba(255, 253, 249, 0.76);
        color: #30414e;
        font-weight: 700;
        font-size: 0.82rem;
      }

      .section {
        margin-top: 28px;
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: 32px;
        background: rgba(255, 253, 249, 0.88);
        box-shadow: var(--shadow);
      }

      .section-title {
        font-size: clamp(2rem, 3.2vw, 3rem);
        margin-bottom: 16px;
      }

      .section-intro {
        max-width: 760px;
        margin-bottom: 28px;
        font-size: 1.02rem;
      }

      /* Canvas demo blocks — shared by the landing page, feature pages, and category pages.
         Assets come from `npm run demo:studio-clips`; they are captured app recordings. */
      .demo-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .demo-grid--pair {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .demo-figure {
        margin: 0;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--surface);
      }

      .demo-figure picture {
        display: block;
      }

      .demo-figure video {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        border: 1px solid rgba(20, 32, 40, 0.06);
        background: #f1ede6;
      }

      .demo-figure img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        border: 1px solid rgba(20, 32, 40, 0.06);
      }

      .demo-figure figcaption {
        margin-top: 12px;
        font-size: 0.9rem;
        color: #536674;
        line-height: 1.5;
      }

      .demo-figure figcaption a {
        color: var(--accent);
        font-weight: 700;
      }

      @media (max-width: 900px) {
        .demo-grid--pair {
          grid-template-columns: 1fr;
        }
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .card {
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: var(--surface);
      }

      .card h3 {
        font-size: 1.3rem;
        margin-bottom: 12px;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .btn-primary,
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 20px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 800;
      }

      .btn-primary {
        background: #142028;
        color: #f9f5ee;
      }

      .btn-secondary {
        border: 1px solid var(--line);
        background: rgba(255, 253, 249, 0.9);
        color: var(--text);
      }

      .btn-primary:hover,
      .btn-primary:focus-visible,
      .btn-secondary:hover,
      .btn-secondary:focus-visible {
        transform: translateY(-1px);
      }

      .bullet-list {
        margin: 0;
        padding-left: 20px;
        color: var(--text-soft);
      }

      .bullet-list li + li {
        margin-top: 10px;
      }

      @media (max-width: 900px) {
        .card-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        main {
          padding-top: 8px;
        }

        .page-shell {
          padding: 0 12px 48px;
        }

        .section {
          padding: 22px;
          border-radius: 24px;
        }
      }
    </style>
  </head>
  <body>
    <SiteHeader lang={lang} />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script>
      /**
       * Canvas demo clips. They ship with `preload="none"` and no `autoplay`, so nothing is
       * fetched until a clip is near the viewport. Visitors who ask for reduced motion keep
       * the poster and get controls instead of an animation starting on its own.
       */
      const demos = Array.from(document.querySelectorAll('video.demo-video'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      for (const video of demos) {
        if (reducedMotion.matches) {
          video.controls = true;
          continue;
        }

        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            observer.disconnect();
            video.autoplay = true;
            void video.play().catch(() => {});
          }
        }, { rootMargin: '250px' });

        observer.observe(video);
      }

      // Someone toggling the OS setting mid-session should not keep an animation running.
      reducedMotion.addEventListener('change', (event) => {
        for (const video of demos) {
          if (event.matches) {
            video.pause();
            video.controls = true;
          } else {
            video.controls = false;
            void video.play().catch(() => {});
          }
        }
      });
    </script>
  </body>
</html>
