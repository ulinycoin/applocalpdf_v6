{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "PDF Basics",
        "Advanced Features",
        "Security & Privacy",
        "Productivity Tips",
        "Tutorials",
        "Comparisons",
        "Use Cases"
      ]
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "coverImage": {
      "type": "string"
    },
    "coverImageAlt": {
      "type": "string"
    },
    "ogImage": {
      "type": "string"
    },
    "canonicalURL": {
      "type": "string",
      "format": "uri"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tableOfContents": {
      "default": true,
      "type": "boolean"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "relatedTools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "merge-pdf",
          "split-pdf",
          "compress-pdf",
          "protect-pdf",
          "ocr-pdf",
          "add-text-pdf",
          "watermark-pdf",
          "rotate-pdf",
          "delete-pages-pdf",
          "extract-pages-pdf",
          "unlock-pdf",
          "images-to-pdf",
          "pdf-to-images",
          "pdf-to-word",
          "word-to-pdf",
          "sign-pdf",
          "flatten-pdf"
        ]
      }
    },
    "author": {
      "default": "LocalPDF Team",
      "type": "string"
    },
    "authorImage": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate",
    "tags",
    "category",
    "draft",
    "featured",
    "tableOfContents",
    "author"
  ],
  "additionalProperties": false
}