{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:all",
  "outputDirectory": "dist",
  "installCommand": "npm install",

  "devCommand": "npm run dev:all",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.localpdf.online"
        }
      ],
      "destination": "https://localpdf.online/:path*",
      "statusCode": 301
    },
    {
      "source": "/edit-text-pdf",
      "destination": "/features/edit-pdf",
      "statusCode": 308
    },
    {
      "source": "/add-text-pdf",
      "destination": "/features/edit-pdf",
      "statusCode": 308
    },
    {
      "source": "/merge-pdf",
      "destination": "/features/merge-pdf",
      "statusCode": 308
    },
    {
      "source": "/ocr-pdf",
      "destination": "/features/ocr-pdf",
      "statusCode": 308
    },
    {
      "source": "/compress-pdf",
      "destination": "/features/compress-pdf",
      "statusCode": 308
    },
    {
      "source": "/split-pdf",
      "destination": "/features/split-pdf",
      "statusCode": 308
    },
    {
      "source": "/sign-pdf",
      "destination": "/features/sign-pdf",
      "statusCode": 308
    },
    {
      "source": "/pdf-to-word",
      "destination": "/features/convert-pdf",
      "statusCode": 308
    },
    {
      "source": "/word-to-pdf",
      "destination": "/features/convert-pdf",
      "statusCode": 308
    },
    {
      "source": "/images-to-pdf",
      "destination": "/features/convert-pdf",
      "statusCode": 308
    },
    {
      "source": "/pdf-to-images",
      "destination": "/features/convert-pdf",
      "statusCode": 308
    },
    {
      "source": "/add-form-fields-pdf",
      "destination": "/features/edit-pdf",
      "statusCode": 308
    },
    {
      "source": "/delete-pages-pdf",
      "destination": "/features/split-pdf",
      "statusCode": 308
    },
    {
      "source": "/extract-pages-pdf",
      "destination": "/features/split-pdf",
      "statusCode": 308
    },
    {
      "source": "/extract-images-pdf",
      "destination": "/features/convert-pdf",
      "statusCode": 308
    },
    {
      "source": "/organize-pdf",
      "destination": "/features/edit-pdf",
      "statusCode": 308
    },
    {
      "source": "/rotate-pdf",
      "destination": "/features/edit-pdf",
      "statusCode": 308
    },
    {
      "source": "/watermark-pdf",
      "destination": "/features/edit-pdf",
      "statusCode": 308
    },
    {
      "source": "/protect-pdf",
      "destination": "/security",
      "statusCode": 308
    },
    {
      "source": "/flatten-pdf",
      "destination": "/features/edit-pdf",
      "statusCode": 308
    },
    {
      "source": "/tables-pdf",
      "destination": "/features/convert-pdf",
      "statusCode": 308
    },
    {
      "source": "/comparison",
      "destination": "/faq",
      "statusCode": 308
    },
    {
      "source": "/learn",
      "destination": "/faq",
      "statusCode": 308
    },
    {
      "source": "/learn/:slug",
      "destination": "/faq",
      "statusCode": 308
    },
    {
      "source": "/extension",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/(legal-privacy-pdf|finance-privacy-pdf|medical-privacy-pdf)",
      "destination": "/security",
      "statusCode": 308
    },
    {
      "source": "/de",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/(de|ja)/(edit-text-pdf|add-text-pdf)",
      "destination": "/features/edit-pdf",
      "statusCode": 308
    },
    {
      "source": "/(de|ja)/merge-pdf",
      "destination": "/features/merge-pdf",
      "statusCode": 308
    },
    {
      "source": "/(de|ja)/ocr-pdf",
      "destination": "/features/ocr-pdf",
      "statusCode": 308
    },
    {
      "source": "/(de|ja)/compress-pdf",
      "destination": "/features/compress-pdf",
      "statusCode": 308
    },
    {
      "source": "/(de|ja)/split-pdf",
      "destination": "/features/split-pdf",
      "statusCode": 308
    },
    {
      "source": "/(de|ja)/sign-pdf",
      "destination": "/features/sign-pdf",
      "statusCode": 308
    },
    {
      "source": "/(de|ja)/(pdf-to-word|word-to-pdf|images-to-pdf|pdf-to-images)",
      "destination": "/features/convert-pdf",
      "statusCode": 308
    },
    {
      "source": "/de/:path*",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/contact",
      "destination": "/faq",
      "statusCode": 301
    },
    {
      "source": "/localpdf.online",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/ja/:path+",
      "destination": "/ja",
      "statusCode": 301
    },
    {
      "source": "/zh/:path+",
      "destination": "/zh",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/\\.well-known/llm.txt",
      "destination": "/llm.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml"
    },
    {
      "source": "/ingest/static/:path*",
      "destination": "https://eu-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://eu.i.posthog.com/:path*"
    },
    {
      "source": "/app{/}?",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/studio",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/studio/edit",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/studio/convert",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/share",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },


    {
      "source": "/(about|privacy|terms|faq|security)",
      "destination": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://va.vercel-scripts.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://tmpfiles.org https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://vitals.vercel-insights.com https://eu.i.posthog.com https://eu-assets.i.posthog.com https://eu.posthog.com; worker-src 'self' blob:; child-src 'self' blob: https://vercel.live; frame-src 'self' blob: https://vercel.live; manifest-src 'self'; media-src 'self' data: blob:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/app{/}?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/blog-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, x-api-key, Authorization, X-Signature"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true
}
